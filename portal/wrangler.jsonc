// Cloudflare Workers settings: serve the built Flutter web app (build/web/).
// Unknown paths fall back to index.html so links like /leads/... work after a refresh.
{
  "name": "isangotech-portal",
  "compatibility_date": "2026-10-01",
  // The real address. Cloudflare creates the DNS record and certificate for it.
  "routes": [{ "pattern": "portal.isangotech.co.za", "custom_domain": true }],
  // Keep the old isangotech-portal.<account>.workers.dev address working too.
  "workers_dev": true,
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application"
  }
}
