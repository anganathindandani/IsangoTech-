// Cloudflare Workers settings: serve the built Astro site (dist/) as static files.
{
  "name": "isangotech",
  "compatibility_date": "2026-10-01",
  // Answers Meta's verification address itself; see worker.js.
  "main": "./worker.js",
  // The real address. Cloudflare creates the DNS records and certificates for these.
  "routes": [
    { "pattern": "isangotech.co.za", "custom_domain": true },
    { "pattern": "www.isangotech.co.za", "custom_domain": true }
  ],
  // Keep the old isangotech.<account>.workers.dev address working too.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/bq3jaax82hsxmiqigqlbbwoagw1b7f.html"]
  }
}
