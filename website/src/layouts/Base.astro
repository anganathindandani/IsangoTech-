---
import "@fontsource/outfit/latin-600.css";
import "@fontsource/outfit/latin-700.css";
import "@fontsource/dm-sans/latin-400.css";
import "@fontsource/dm-sans/latin-500.css";
import "../styles/global.css";
import Beadwork from "../components/Beadwork.astro";
import { nav, site, siteText } from "../site";
import { counterpart, langNames, langOf, localize, pick, type Lang } from "../i18n";

interface Props {
  title?: string;
  /** Replaces the whole <title> when the short title isn't descriptive enough for search. */
  searchTitle?: string;
  description?: string;
  /** Keeps a page out of search results (the 404 page). */
  noindex?: boolean;
}

const lang = langOf(Astro.url);
const other: Lang = lang === "en" ? "xh" : "en";
const words = siteText[lang];
const L = (path: string) => localize(path, lang);
const { title, searchTitle, description = words.description, noindex = false } = Astro.props;
const pageTitle = searchTitle
  ? `${searchTitle} · ${site.name}`
  : title
    ? `${title} · ${site.name}`
    : `${site.name} · ${words.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The same page in each language, for the switcher and for search engines.
const alternates = { en: new URL(counterpart(Astro.url.pathname, "en"), Astro.site), xh: new URL(counterpart(Astro.url.pathname, "xh"), Astro.site) };
const ui = pick(lang, {
  en: { skip: "Skip to content", home: `${site.name} home`, menu: "Menu", main: "Main", footer: "Footer", getStarted: "Get started", privacy: "Privacy policy", terms: "Terms", reg: "Reg. no.", whatsapp: "WhatsApp us", whatsappLabel: "Chat with us on WhatsApp", switchLabel: "Read this page in isiXhosa", language: "Language", explore: "Explore", contact: "Get in touch", follow: "Follow IsangoTech" },
  xh: { skip: "Tsiba uye kumxholo", home: `Ikhaya le-${site.name}`, menu: "Imenyu", main: "Okuphambili", footer: "Ezantsi", getStarted: "Qalisa", privacy: "Umgaqo-nkqubo wabucala", terms: "Imiqathango", reg: "Inombolo yobhaliso", whatsapp: "Sithumelele i-WhatsApp", whatsappLabel: "Ncokola nathi kwi-WhatsApp", switchLabel: "Read this page in English", language: "Ulwimi", explore: "Phonononga", contact: "Qhagamshelana nathi", follow: "Landela i-IsangoTech" },
});
const shareImage = new URL("/share.png", Astro.site);

// What Google shows for the business in search and Maps. Empty details are left out.
const business = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": new URL("/#business", Astro.site).href,
  name: site.name,
  ...(site.legalName && { legalName: site.legalName }),
  ...(site.companyRegistrationNumber && {
    identifier: { "@type": "PropertyValue", propertyID: "CIPC registration number", value: site.companyRegistrationNumber },
  }),
  slogan: words.tagline,
  description: words.description,
  url: new URL("/", Astro.site).href,
  logo: new URL("/apple-touch-icon.png", Astro.site).href,
  image: shareImage.href,
  address: { "@type": "PostalAddress", addressLocality: "East London", addressRegion: "Eastern Cape", addressCountry: "ZA" },
  areaServed: [
    { "@type": "City", name: "East London" },
    { "@type": "State", name: "Eastern Cape" },
    { "@type": "Country", name: "South Africa" },
  ],
  knowsAbout: ["Website design", "Online booking systems", "Business process automation", "AI automation", "Small business software"],
  ...(site.email && { email: site.email }),
  ...(site.phone && { telephone: site.phone }),
  ...(site.founder.name && { founder: { "@type": "Person", name: site.founder.name, jobTitle: site.founder.role } }),
  sameAs: [site.social.facebook, site.social.instagram, site.social.linkedin, site.googleBusinessProfileUrl].filter(Boolean),
};
const whatsappLink = site.whatsappNumber ? `https://wa.me/${site.whatsappNumber}` : null;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrentPath = (href: string) => current === L(href) || current.startsWith(`${L(href)}/`);
// Footer icons. The links are placeholders until the accounts are live.
const socialLinks = [
  { href: "#", label: "WhatsApp", icon: "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" },
  { href: "#", label: "Facebook", icon: "M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z" },
  { href: "#", label: "Instagram", icon: "M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077" },
  { href: "#", label: "LinkedIn", icon: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang === "xh" ? "xh-ZA" : "en-ZA"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="en-ZA" href={alternates.en} />
          <link rel="alternate" hreflang="xh-ZA" href={alternates.xh} />
          <link rel="alternate" hreflang="x-default" href={alternates.en} />
        </>
      )
    }
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === "xh" ? "xh_ZA" : "en_ZA"} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${words.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1B2A4A" />
    <script is:inline>
      // Hide scroll-reveal content only when motion is allowed and the script can run.
      // If the motion script hasn't started within 3 s, show everything.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
        setTimeout(() => {
          if (!document.documentElement.dataset.motionReady) document.documentElement.classList.add("reveal-all");
        }, 3000);
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href={L("/")} class="logo" aria-label={ui.home}>
          <img src="/brand/isangotech-logo.svg" alt={site.name} width="150" height="32" />
        </a>
        <nav class="desktop-nav" aria-label={ui.main}>
          {
            nav.map((item) => (
              <a href={L(item.href)} aria-current={isCurrentPath(item.href) ? "page" : undefined}>
                {item.label[lang]}
              </a>
            ))
          }
        </nav>
        <a class="lang-switch" href={counterpart(Astro.url.pathname, other)} hreflang={other === "xh" ? "xh-ZA" : "en-ZA"} lang={other === "xh" ? "xh-ZA" : "en-ZA"} aria-label={ui.switchLabel}>
          {langNames[other]}
        </a>
        <a class="button header-cta" href={L("/get-started")}>{ui.getStarted}</a>
        <details class="mobile-nav">
          <summary aria-label={ui.menu}>{ui.menu}</summary>
          <nav aria-label={ui.main}>
            {
              nav.map((item) => (
                <a href={L(item.href)} aria-current={isCurrentPath(item.href) ? "page" : undefined}>
                  {item.label[lang]}
                </a>
              ))
            }
            <a href={L("/get-started")}>{ui.getStarted}</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <Beadwork size={28} />
      <div class="container footer-inner">
        <div class="footer-brand">
          <img src="/brand/isangotech-logo-reversed.svg" alt={site.name} width="160" height="34" loading="lazy" />
          <p class="tagline">{words.tagline}</p>
          <ul class="social" aria-label={ui.follow}>
            {
              socialLinks.map((l) => (
                <li>
                  <a href={l.href} aria-label={l.label} title={l.label}>
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                      <path d={l.icon} fill="currentColor" />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <nav aria-label={ui.footer}>
          <h2 class="footer-heading">{ui.explore}</h2>
          {nav.map((item) => <a href={L(item.href)}>{item.label[lang]}</a>)}
          <a href={L("/get-started")}>{ui.getStarted}</a>
          <a href={counterpart(Astro.url.pathname, other)} hreflang={other === "xh" ? "xh-ZA" : "en-ZA"} lang={other === "xh" ? "xh-ZA" : "en-ZA"}>
            {ui.language}: {langNames[other]}
          </a>
        </nav>
        <div class="contact">
          <h2 class="footer-heading">{ui.contact}</h2>
          {whatsappLink && <a href={whatsappLink}>WhatsApp</a>}
          {site.phone && <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>}
          {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
          <p class="area">{site.areaServed}</p>
        </div>
        <div class="legal">
          <span>
            © {year}
            {site.name}{site.legalName && ` · ${site.legalName}`}{site.companyRegistrationNumber && ` · ${ui.reg} ${site.companyRegistrationNumber}`}
          </span>
          <span class="legal-links">
            <a href={L("/privacy")}>{ui.privacy}</a>
            <a href={L("/terms")}>{ui.terms}</a>
          </span>
        </div>
      </div>
    </footer>

    {
      whatsappLink && (
        <a class="whatsapp" href={whatsappLink} aria-label={ui.whatsappLabel}>
          {ui.whatsapp}
        </a>
      )
    }
  </body>
</html>

<script>
  import "../scripts/motion.ts";
</script>

<style>
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 10;
    background: var(--white);
    padding: 0.5rem 1rem;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid rgb(27 42 74 / 0.08);
    transition: box-shadow 0.3s ease;
    view-transition-name: site-header;
  }
  .site-header.is-scrolled {
    box-shadow: 0 6px 24px rgb(27 42 74 / 0.1);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }
  .logo {
    margin-right: auto;
  }
  .logo img {
    display: block;
    width: 150px;
    height: auto;
  }
  .desktop-nav {
    display: none;
    gap: 1.5rem;
  }
  .desktop-nav a,
  .mobile-nav a {
    color: var(--indigo);
    text-decoration: none;
    font-weight: 500;
  }
  .desktop-nav a {
    position: relative;
    padding-block: 0.35rem;
  }
  .desktop-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--ochre);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }
  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after,
  .desktop-nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }
  .desktop-nav a[aria-current="page"],
  .mobile-nav a[aria-current="page"] {
    color: var(--turquoise-text);
  }
  .header-cta {
    display: none;
  }
  /* The other language, as a small pill beside the menu. */
  .lang-switch {
    padding: 0.3rem 0.75rem;
    border: 1.5px solid rgb(27 42 74 / 0.2);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--indigo);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.2s, color 0.2s;
  }
  .lang-switch:hover,
  .lang-switch:focus-visible {
    border-color: var(--turquoise);
    color: var(--turquoise-text);
  }
  .mobile-nav summary {
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--indigo);
    border-radius: 999px;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 5;
    display: grid;
    background: var(--white);
    border-bottom: 1px solid rgb(27 42 74 / 0.12);
    box-shadow: 0 12px 24px rgb(27 42 74 / 0.12);
  }
  .mobile-nav nav a {
    padding: 1rem var(--gutter);
    border-top: 1px solid rgb(27 42 74 / 0.08);
  }
  .mobile-nav[open] nav {
    animation: menu-in 0.3s var(--ease-out);
  }
  .mobile-nav[open] nav a {
    animation: menu-item-in 0.35s var(--ease-out) both;
  }
  .mobile-nav[open] nav a:nth-child(2) { animation-delay: 40ms; }
  .mobile-nav[open] nav a:nth-child(3) { animation-delay: 80ms; }
  .mobile-nav[open] nav a:nth-child(4) { animation-delay: 120ms; }
  .mobile-nav[open] nav a:nth-child(5) { animation-delay: 160ms; }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-8px); }
  }
  @keyframes menu-item-in {
    from { opacity: 0; transform: translateX(-10px); }
  }
  @media (min-width: 60rem) {
    .desktop-nav,
    .header-cta {
      display: flex;
    }
    .mobile-nav {
      display: none;
    }
  }

  .site-footer {
    background: var(--indigo);
    color: rgb(245 235 221 / 0.78);
  }
  .footer-inner {
    display: grid;
    gap: 2.25rem;
    padding-block: 3.5rem 1.5rem;
  }
  @media (min-width: 48rem) {
    .footer-inner {
      grid-template-columns: 1.6fr 1fr 1.2fr;
    }
    .legal {
      grid-column: 1 / -1;
    }
  }
  .footer-brand img {
    display: block;
    width: 160px;
  }
  .tagline {
    margin: 0.75rem 0 0;
    color: var(--ochre);
  }
  .footer-heading {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--white);
  }
  .site-footer nav,
  .contact {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    justify-items: start;
  }
  .site-footer a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--white);
    text-decoration: underline;
    text-decoration-color: var(--ochre);
    text-underline-offset: 0.25em;
  }
  .contact a {
    overflow-wrap: anywhere;
  }
  .area {
    margin: 0;
    font-size: 0.9rem;
  }
  .social {
    display: flex;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgb(245 235 221 / 0.25);
    border-radius: 50%;
    color: var(--sand);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s, transform 0.2s var(--ease-out);
  }
  .site-footer .social a:hover,
  .site-footer .social a:focus-visible {
    background: var(--turquoise);
    border-color: var(--turquoise);
    color: var(--white);
    text-decoration: none;
    transform: translateY(-2px);
  }
  .legal {
    display: flex;
