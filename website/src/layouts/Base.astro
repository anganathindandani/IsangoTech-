---
import "@fontsource/outfit/latin-600.css";
import "@fontsource/outfit/latin-700.css";
import "@fontsource/dm-sans/latin-400.css";
import "@fontsource/dm-sans/latin-500.css";
import "../styles/global.css";
import Beadwork from "../components/Beadwork.astro";
import { nav, site } from "../site";

interface Props {
  title?: string;
  /** Replaces the whole <title> when the short title isn't descriptive enough for search. */
  searchTitle?: string;
  description?: string;
  /** Keeps a page out of search results (the 404 page). */
  noindex?: boolean;
}

const { title, searchTitle, description = site.description, noindex = false } = Astro.props;
const pageTitle = searchTitle
  ? `${searchTitle} · ${site.name}`
  : title
    ? `${title} · ${site.name}`
    : `${site.name} · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL("/share.png", Astro.site);

// What Google shows for the business in search and Maps. Empty details are left out.
const business = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": new URL("/#business", Astro.site).href,
  name: site.name,
  slogan: site.tagline,
  description: site.description,
  url: new URL("/", Astro.site).href,
  logo: new URL("/apple-touch-icon.png", Astro.site).href,
  image: shareImage.href,
  address: { "@type": "PostalAddress", addressLocality: "East London", addressRegion: "Eastern Cape", addressCountry: "ZA" },
  areaServed: [
    { "@type": "City", name: "East London" },
    { "@type": "State", name: "Eastern Cape" },
    { "@type": "Country", name: "South Africa" },
  ],
  knowsAbout: ["Website design", "Online booking systems", "Business process automation", "AI automation", "Small business software"],
  ...(site.email && { email: site.email }),
  ...(site.phone && { telephone: site.phone }),
  ...(site.founder.name && { founder: { "@type": "Person", name: site.founder.name, jobTitle: site.founder.role } }),
  sameAs: [site.social.facebook, site.social.instagram, site.social.linkedin, site.googleBusinessProfileUrl].filter(Boolean),
};
const whatsappLink = site.whatsappNumber ? `https://wa.me/${site.whatsappNumber}` : null;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => current === href || current.startsWith(`${href}/`);
const socialLinks = [
  { href: site.social.facebook, label: "Facebook" },
  { href: site.social.instagram, label: "Instagram" },
  { href: site.social.linkedin, label: "LinkedIn" },
  { href: site.googleBusinessProfileUrl, label: "Google" },
].filter((l) => l.href);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1B2A4A" />
    <script is:inline>
      // Hide scroll-reveal content only when motion is allowed and the script can run.
      // If the motion script hasn't started within 3 s, show everything.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
        setTimeout(() => {
          if (!document.documentElement.dataset.motionReady) document.documentElement.classList.add("reveal-all");
        }, 3000);
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label={`${site.name} home`}>
          <img src="/brand/isangotech-logo.svg" alt={site.name} width="150" height="32" />
        </a>
        <nav class="desktop-nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <a class="button header-cta" href="/get-started">Get started</a>
        <details class="mobile-nav">
          <summary aria-label="Menu">Menu</summary>
          <nav aria-label="Main">
            {
              nav.map((item) => (
                <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              ))
            }
            <a href="/get-started">Get started</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <Beadwork size={28} />
      <div class="container footer-inner">
        <div>
          <img src="/brand/isangotech-logo-reversed.svg" alt={site.name} width="160" height="34" loading="lazy" />
          <p class="tagline">{site.tagline}</p>
        </div>
        <nav aria-label="Footer">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/get-started">Get started</a>
        </nav>
        <div class="contact">
          {whatsappLink && <a href={whatsappLink}>WhatsApp</a>}
          {site.phone && <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>}
          {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
          {socialLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
        <p class="legal">
          <a href="/privacy">Privacy policy</a>
          <a href="/terms">Terms</a>
          <span>
            © {year}
            {site.name}{site.companyRegistrationNumber && ` · Reg. no. ${site.companyRegistrationNumber}`}
          </span>
        </p>
      </div>
    </footer>

    {
      whatsappLink && (
        <a class="whatsapp" href={whatsappLink} aria-label="Chat with us on WhatsApp">
          WhatsApp us
        </a>
      )
    }
  </body>
</html>

<script>
  import "../scripts/motion.ts";
</script>

<style>
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 10;
    background: var(--white);
    padding: 0.5rem 1rem;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid rgb(27 42 74 / 0.08);
    transition: box-shadow 0.3s ease;
    view-transition-name: site-header;
  }
  .site-header.is-scrolled {
    box-shadow: 0 6px 24px rgb(27 42 74 / 0.1);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }
  .logo {
    margin-right: auto;
  }
  .logo img {
    display: block;
    width: 150px;
    height: auto;
  }
  .desktop-nav {
    display: none;
    gap: 1.5rem;
  }
  .desktop-nav a,
  .mobile-nav a {
    color: var(--indigo);
    text-decoration: none;
    font-weight: 500;
  }
  .desktop-nav a {
    position: relative;
    padding-block: 0.35rem;
  }
  .desktop-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--ochre);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }
  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after,
  .desktop-nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }
  .desktop-nav a[aria-current="page"],
  .mobile-nav a[aria-current="page"] {
    color: var(--turquoise-text);
  }
  .header-cta {
    display: none;
  }
  .mobile-nav summary {
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--indigo);
    border-radius: 999px;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 5;
    display: grid;
    background: var(--white);
    border-bottom: 1px solid rgb(27 42 74 / 0.12);
    box-shadow: 0 12px 24px rgb(27 42 74 / 0.12);
  }
  .mobile-nav nav a {
    padding: 1rem var(--gutter);
    border-top: 1px solid rgb(27 42 74 / 0.08);
  }
  .mobile-nav[open] nav {
    animation: menu-in 0.3s var(--ease-out);
  }
  .mobile-nav[open] nav a {
    animation: menu-item-in 0.35s var(--ease-out) both;
  }
  .mobile-nav[open] nav a:nth-child(2) { animation-delay: 40ms; }
  .mobile-nav[open] nav a:nth-child(3) { animation-delay: 80ms; }
  .mobile-nav[open] nav a:nth-child(4) { animation-delay: 120ms; }
  .mobile-nav[open] nav a:nth-child(5) { animation-delay: 160ms; }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-8px); }
  }
  @keyframes menu-item-in {
    from { opacity: 0; transform: translateX(-10px); }
  }
  @media (min-width: 60rem) {
    .desktop-nav,
    .header-cta {
      display: flex;
    }
    .mobile-nav {
      display: none;
    }
  }

  .site-footer {
    background: var(--indigo);
    color: var(--sand);
  }
  .footer-inner {
    display: grid;
    gap: 1.5rem;
    padding-block: 2.5rem;
  }
  @media (min-width: 48rem) {
    .footer-inner {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
    .legal {
      grid-column: 1 / -1;
    }
  }
  .tagline {
    margin: 0.5rem 0 0;
    color: var(--ochre);
  }
  .site-footer nav,
  .contact {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  .site-footer a {
    color: var(--sand);
  }
  .legal {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.875rem;
    opacity: 0.85;
  }
  .whatsapp {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 5;
    padding: 0.75rem 1.1rem;
    border-radius: 999px;
    background: var(--turquoise-text);
    color: var(--white);
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 4px 16px rgb(27 42 74 / 0.25);
  }
</style>
