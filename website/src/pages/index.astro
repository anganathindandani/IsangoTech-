---
import Base from "../layouts/Base.astro";
import Beadwork from "../components/Beadwork.astro";
import DoorHero from "../components/DoorHero.astro";
import CallToAction from "../components/CallToAction.astro";
import IndustryTiles from "../components/IndustryTiles.astro";
import FoundingOffer from "../components/FoundingOffer.astro";
import FounderIntro from "../components/FounderIntro.astro";
import { testimonials } from "../data/testimonials";
import { formatPrice, packagesFor } from "../data/packages";
import { langOf, localize, pick } from "../i18n";

const lang = langOf(Astro.url);
const L = (path: string) => localize(path, lang);
const starter = packagesFor(lang).find((p) => p.group === "website")!;
const w = pick(lang, {
  en: {
    searchTitle: "Websites for small businesses in East London",
    description: "IsangoTech builds websites and sets up Google Business Profiles for small businesses in East London and the Eastern Cape. From R3 500 once-off, no monthly fee, and the website is yours.",
    eyebrow: "Proudly African · East London and beyond",
    headline: "We get your business found online.",
    offer: "Websites and Google Business Profiles for small businesses in East London and the Eastern Cape, so customers find you, trust you and reach you in one tap.",
    start: "Get started",
    prices: "See what's included",
    outcomesLabel: "What you get",
    outcomes: [
      ["Found on Google", "Your business shows up when people nearby search for what you do."],
      ["Easy to trust", "A clear, professional website with your prices, photos and hours."],
      ["One tap to reach you", "A WhatsApp button on every page, so customers message you straight away."],
    ],
    starterHeading: "A website that's yours",
    allPrices: "All prices",
    industries: "Built for businesses like yours",
    industriesLead: "We know what customers look for in these businesses, and we help any small business get found the same way.",
    soonEyebrow: "Coming soon",
    soonHeading: "WhatsApp Assistant",
    soonText: "We're building an assistant that answers your customers on WhatsApp while you work. Want to hear when it's ready?",
    soonButton: "Get notified",
    testimonials: "What our clients say",
  },
  xh: {
    searchTitle: "Ii-website zamashishini amancinci eMonti",
    description: "I-IsangoTech yakha ii-website kwaye iseta ii-Google Business Profile zamashishini amancinci eMonti naseMpuma Koloni. Ukusuka ku-R3 500 kanye kuphela, akukho ntlawulo yenyanga, kwaye i-website yeyakho.",
    eyebrow: "Simi ngobu-Afrika · EMonti nangaphaya",
    headline: "Senza ishishini lakho lifumaneke kwi-intanethi.",
    offer: "Ii-website nee-Google Business Profile zamashishini amancinci eMonti naseMpuma Koloni, ukuze abathengi bakufumane, bakuthembe, kwaye bakufikelele ngokucofa kanye.",
    start: "Qalisa",
    prices: "Bona okubandakanyiweyo",
    outcomesLabel: "Oko ukufumanayo",
    outcomes: [
      ["Ufumaneka kwi-Google", "Ishishini lakho liyavela xa abantu abakufutshane bekhangela oko ukwenzayo."],
      ["Kulula ukukuthemba", "I-website ecacileyo nenobuchule, enamaxabiso akho, iifoto neeyure."],
      ["Bakufikelela ngokucofa kanye", "Iqhosha le-WhatsApp kulo lonke iphepha, ukuze abathengi bakuthumelele umyalezo kwangoko."],
    ],
    starterHeading: "I-website eyeyakho",
    allPrices: "Onke amaxabiso",
    industries: "Yakhelwe amashishini afana nelakho",
    industriesLead: "Siyazi ukuba abathengi bakhangela ntoni kula mashishini, kwaye sinceda nawuphi na ishishini elincinci ukuba lifumaneke ngendlela efanayo.",
    soonEyebrow: "Iyeza kungekudala",
    soonHeading: "I-WhatsApp Assistant",
    soonText: "Sakha i-assistant ephendula abathengi bakho kwi-WhatsApp ngoxa usebenza. Ufuna ukwazi xa ilungile?",
    soonButton: "Ndazise",
    testimonials: "Abathengi bethu bathini",
  },
});

const icons = [
  // Magnifier over a map pin
  '<circle cx="21" cy="21" r="13" fill="none" stroke="currentColor" stroke-width="3"/><path d="M31 31l10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M21 13a6 6 0 0 1 6 6c0 5-6 10-6 10s-6-5-6-10a6 6 0 0 1 6-6z" fill="#E07A1F"/>',
  // Browser window with a tick
  '<rect x="6" y="9" width="36" height="30" rx="4" fill="none" stroke="currentColor" stroke-width="3"/><path d="M6 17h36" stroke="currentColor" stroke-width="3"/><path d="M17 28l5 5 9-10" fill="none" stroke="#E07A1F" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>',
  // Chat bubble
  '<path d="M8 12a4 4 0 0 1 4-4h24a4 4 0 0 1 4 4v16a4 4 0 0 1-4 4H20l-8 7v-7h0a4 4 0 0 1-4-4z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><circle cx="17" cy="20" r="2.5" fill="#E07A1F"/><circle cx="24" cy="20" r="2.5" fill="#E07A1F"/><circle cx="31" cy="20" r="2.5" fill="#E07A1F"/>',
];
---

<Base
  searchTitle={w.searchTitle}
  description={w.description}
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow hero-in" style="--d: 0">{w.eyebrow}</p>
        <h1 class="hero-in" style="--d: 1">{w.headline}</h1>
        <p class="offer hero-in" style="--d: 2">{w.offer}</p>
        <div class="actions hero-in" style="--d: 3">
          <a class="button" href={L("/get-started")}>{w.start} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="secondary" href={L("/services")}>{w.prices}</a>
        </div>
      </div>
      <div class="hero-door">
        <DoorHero />
      </div>
    </div>
  </section>
  <Beadwork />

  <section class="container outcomes" aria-label={w.outcomesLabel}>
    {
      icons.map((icon, i) => (
        <div class="outcome">
          <svg viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" set:html={icon} />
          <h2>{w.outcomes.at(i)?.[0]}</h2>
          <p>{w.outcomes.at(i)?.[1]}</p>
        </div>
      ))
    }
  </section>

  <section class="container starter" aria-labelledby="starter-heading">
    <div class="starter-card">
      <div>
        <p class="eyebrow">{starter.name}</p>
        <h2 id="starter-heading">{w.starterHeading}</h2>
        <p class="starter-price">{formatPrice(starter, lang)}</p>
        <p>{starter.priceDetail}</p>
      </div>
      <div>
        <ul>
          {starter.includes.map((i) => <li>{i}</li>)}
        </ul>
        <div class="actions">
          <a class="button" href={L("/get-started")}>{w.start} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="secondary" href={L("/services")}>{w.allPrices}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container industries" aria-labelledby="industries-heading">
    <h2 id="industries-heading">{w.industries}</h2>
    <p>{w.industriesLead}</p>
    <IndustryTiles />
  </section>

  <FounderIntro />

  <FoundingOffer />

  <section class="container soon" aria-labelledby="soon-heading">
    <div class="soon-card">
      <div>
        <p class="eyebrow">{w.soonEyebrow}</p>
        <h2 id="soon-heading">{w.soonHeading}</h2>
        <p>{w.soonText}</p>
      </div>
      <a class="button" href={`${L("/get-started")}?interest=assistant`}>{w.soonButton}</a>
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="container testimonials" aria-labelledby="testimonials-heading">
        <h2 id="testimonials-heading">{w.testimonials}</h2>
        <div class="quotes">
          {testimonials.map((t) => (
            <figure>
              <blockquote>"{t.quote}"</blockquote>
              <figcaption>
                {t.name}, {t.business}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <CallToAction />
</Base>

<style>
  .hero {
    background: linear-gradient(180deg, var(--white) 0%, var(--white) 55%, #fbf5ec 100%);
    padding-block: 2.5rem 2rem;
    overflow: hidden;
  }
  .hero-inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  /* On phones the headline and button come first; the door follows, smaller. */
  .hero-door {
    display: flex;
    justify-content: center;
    padding-bottom: 1.5rem;
    --door-w: clamp(5.5rem, 24vw, 8rem);
  }
  @media (min-width: 52rem) {
    .hero {
      padding-block: 4.5rem 3.5rem;
    }
    .hero-inner {
      grid-template-columns: 1.25fr 1fr;
    }
    .hero-door {
      padding-bottom: 4rem;
      --door-w: clamp(7.5rem, 30vw, 19rem);
    }
  }
  .hero h1 {
    max-width: 13ch;
  }
  .offer {
    max-width: 36rem;
    font-size: 1.15rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.75rem;
  }
  .actions .button {
    padding: 0.9rem 1.5rem;
    font-size: 1.05rem;
  }
  .secondary {
    font-weight: 500;
  }
  /* Headline lines arrive one after another as the door opens. */
  .hero-in {
    animation: hero-in 0.8s var(--ease-out) both;
    animation-delay: calc(0.2s + var(--d) * 0.12s);
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  .outcomes {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    padding-block: 3.5rem 4rem;
  }
  .outcome {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--white);
    color: var(--indigo);
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }
  .outcome:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px -12px rgb(27 42 74 / 0.25);
  }
  .outcome svg {
    color: var(--turquoise-text);
    margin-bottom: 0.75rem;
  }
  .outcomes h2 {
    font-size: 1.4rem;
    margin-bottom: 0.35rem;
  }
  .outcomes p {
    margin: 0;
  }
  .industries {
    padding-block: 4rem 0;
  }
  .testimonials {
    padding-block: 3rem 0;
  }
  .quotes {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  figure {
    margin: 0;
    padding: 1.25rem;
    background: var(--white);
    border-radius: var(--radius);
  }
  blockquote {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
  }
  figcaption {
    font-weight: 500;
  }
  .starter {
    padding-block: 1rem 3rem;
  }
  .starter-card {
    display: grid;
    gap: 0 2.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--white);
    border-radius: var(--radius);
    border-top: 6px solid var(--turquoise);
  }
  @media (min-width: 52rem) {
    .starter-card {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .starter-card .eyebrow {
    color: var(--terracotta);
  }
  .starter-price {
    margin: 0;
    font: 600 1.5rem/1.3 var(--font-heading);
    color: var(--turquoise-text);
  }
  .starter-card ul {
    padding-left: 1.2rem;
    margin-top: 0;
  }
  .starter-card li {
    margin-bottom: 0.4rem;
  }
  .starter-card .actions {
    margin-top: 1.25rem;
  }
  .soon {
    padding-block: 0 3.5rem;
  }
  .soon-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    background: rgb(43 168 160 / 0.1);
    border-left: 4px solid var(--turquoise);
  }
  .soon-card > div {
    max-width: 40rem;
  }
  .soon-card h2 {
    font-size: 1.4rem;
    margin-bottom: 0.25rem;
  }
  .soon-card p {
    margin: 0;
  }
  .soon-card .eyebrow {
    margin-bottom: 0.25rem;
  }
</style>
