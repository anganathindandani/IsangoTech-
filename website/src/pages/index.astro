---
import Base from "../layouts/Base.astro";
import Beadwork from "../components/Beadwork.astro";
import DoorHero from "../components/DoorHero.astro";
import CallToAction from "../components/CallToAction.astro";
import IndustryTiles from "../components/IndustryTiles.astro";
import StagePicker from "../components/StagePicker.astro";
import WhatsAppDemo from "../components/WhatsAppDemo.astro";
import FoundingOffer from "../components/FoundingOffer.astro";
import FounderIntro from "../components/FounderIntro.astro";
import { testimonials } from "../data/testimonials";
import { siteText } from "../site";
import { langOf, localize, pick } from "../i18n";

const lang = langOf(Astro.url);
const L = (path: string) => localize(path, lang);
const w = pick(lang, {
  en: {
    searchTitle: "WhatsApp AI assistants and websites in East London",
    description: "IsangoTech sets up WhatsApp AI assistants, bookings, reminders and websites for small businesses in East London and the Eastern Cape. Answer every enquiry, cut no-shows and spend less time on admin.",
    eyebrow: "Proudly African · East London and beyond",
    offer: "WhatsApp AI assistants, bookings, reminders and websites for small businesses, so you get found, never miss a customer and spend less time on admin.",
    start: "Get started",
    prices: "See packages and prices",
    outcomesLabel: "What you get",
    outcomes: [
      ["Time saved", "Bookings, reminders and follow-ups happen without you chasing them."],
      ["More customers", "People find you online and every enquiry gets an answer."],
      ["Less admin", "Your daily work lives in one place, not in spreadsheets and chat threads."],
    ],
    industries: "Built for businesses like yours",
    industriesLead: "We specialise in a few industries so we can reuse what works, and we help any small business on the same path.",
    testimonials: "What our clients say",
  },
  xh: {
    searchTitle: "Ii-WhatsApp AI assistant nee-website eMonti",
    description: "I-IsangoTech iseta ii-WhatsApp AI assistant, ii-booking, izikhumbuzo nee-website zamashishini amancinci eMonti naseMpuma Koloni. Phendula wonke umbuzo, nciphisa abangafikiyo kwaye uchithe ixesha elincinci kwi-admin.",
    eyebrow: "Simi ngobu-Afrika · EMonti nangaphaya",
    offer: "Ii-WhatsApp AI assistant, ii-booking, izikhumbuzo nee-website zamashishini amancinci, ukuze ufumaneke, ungaphoswa ngumthengi, kwaye uchithe ixesha elincinci kwi-admin.",
    start: "Qalisa",
    prices: "Jonga iiphakheji namaxabiso",
    outcomesLabel: "Oko ukufumanayo",
    outcomes: [
      ["Ixesha elongiweyo", "Ii-booking, izikhumbuzo nokulandelela kwenzeka ungakhange ubaleke emva kwazo."],
      ["Abathengi abaninzi", "Abantu bakufumana kwi-intanethi kwaye wonke umbuzo uyaphendulwa."],
      ["I-admin encinci", "Umsebenzi wakho wemihla ngemihla ukwindawo enye, kungekhona kwii-spreadsheet nakwimicu yeengxoxo."],
    ],
    industries: "Yakhelwe amashishini afana nelakho",
    industriesLead: "Sigxila kumashishini ambalwa ukuze sisebenzise kwakhona oko kusebenzayo, kwaye sinceda nawuphi na ishishini elincinci kule ndlela inye.",
    testimonials: "Abathengi bethu bathini",
  },
});

const outcomes = [
  {
    title: "Time saved",
    text: "Bookings, reminders and follow-ups happen without you chasing them.",
    icon: '<circle cx="24" cy="26" r="15" fill="none" stroke="currentColor" stroke-width="3"/><path d="M24 17v9l6 4" fill="none" stroke="#E07A1F" stroke-width="3" stroke-linecap="round"/><path d="M19 6h10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>',
  },
  {
    title: "More customers",
    text: "People find you online and every enquiry gets an answer.",
    icon: '<circle cx="17" cy="17" r="6" fill="none" stroke="currentColor" stroke-width="3"/><path d="M6 38c1-7 5-11 11-11s10 4 11 11" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><circle cx="33" cy="15" r="5" fill="#E07A1F"/><path d="M28 27c6-2 13 2 14 10" fill="none" stroke="#E07A1F" stroke-width="3" stroke-linecap="round"/>',
  },
  {
    title: "Less admin",
    text: "Your daily work lives in one place, not in spreadsheets and chat threads.",
    icon: '<rect x="9" y="8" width="30" height="34" rx="4" fill="none" stroke="currentColor" stroke-width="3"/><path d="M16 20l4 4 8-9" fill="none" stroke="#E07A1F" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 33h16" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>',
  },
];
---

<Base
  searchTitle={w.searchTitle}
  description={w.description}
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow hero-in" style="--d: 0">{w.eyebrow}</p>
        <h1 class="hero-in" style="--d: 1">{siteText[lang].tagline}</h1>
        <p class="offer hero-in" style="--d: 2">{w.offer}</p>
        <div class="actions hero-in" style="--d: 3">
          <a class="button" href={L("/get-started")}>{w.start} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="secondary" href={L("/services")}>{w.prices}</a>
        </div>
      </div>
      <div class="hero-door">
        <DoorHero />
      </div>
    </div>
  </section>
  <Beadwork />

  <section class="container outcomes" aria-label={w.outcomesLabel}>
    {
      outcomes.map((o, i) => (
        <div class="outcome">
          <svg viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" set:html={o.icon} />
          <h2>{w.outcomes.at(i)?.[0]}</h2>
          <p>{w.outcomes.at(i)?.[1]}</p>
        </div>
      ))
    }
  </section>

  <WhatsAppDemo />

  <StagePicker />

  <section class="container industries" aria-labelledby="industries-heading">
    <h2 id="industries-heading">{w.industries}</h2>
    <p>{w.industriesLead}</p>
    <IndustryTiles />
  </section>

  <FounderIntro />

  <FoundingOffer />

  {
    testimonials.length > 0 && (
      <section class="container testimonials" aria-labelledby="testimonials-heading">
        <h2 id="testimonials-heading">{w.testimonials}</h2>
        <div class="quotes">
          {testimonials.map((t) => (
            <figure>
              <blockquote>"{t.quote}"</blockquote>
              <figcaption>
                {t.name}, {t.business}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <CallToAction />
</Base>

<style>
  .hero {
    background: linear-gradient(180deg, var(--white) 0%, var(--white) 55%, #fbf5ec 100%);
    padding-block: 2.5rem 2rem;
    overflow: hidden;
  }
  .hero-inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  /* On phones the headline and button come first; the door follows, smaller. */
  .hero-door {
    display: flex;
    justify-content: center;
    padding-bottom: 1.5rem;
    --door-w: clamp(5.5rem, 24vw, 8rem);
  }
  @media (min-width: 52rem) {
    .hero {
      padding-block: 4.5rem 3.5rem;
    }
    .hero-inner {
      grid-template-columns: 1.25fr 1fr;
    }
    .hero-door {
      padding-bottom: 4rem;
      --door-w: clamp(7.5rem, 30vw, 19rem);
    }
  }
  .hero h1 {
    max-width: 13ch;
  }
  .offer {
    max-width: 36rem;
    font-size: 1.15rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.75rem;
  }
  .actions .button {
    padding: 0.9rem 1.5rem;
    font-size: 1.05rem;
  }
  .secondary {
    font-weight: 500;
  }
  /* Headline lines arrive one after another as the door opens. */
  .hero-in {
    animation: hero-in 0.8s var(--ease-out) both;
    animation-delay: calc(0.2s + var(--d) * 0.12s);
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  .outcomes {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    padding-block: 3.5rem 4rem;
  }
  .outcome {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--white);
    color: var(--indigo);
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }
  .outcome:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px -12px rgb(27 42 74 / 0.25);
  }
  .outcome svg {
    color: var(--turquoise-text);
    margin-bottom: 0.75rem;
  }
  .outcomes h2 {
    font-size: 1.4rem;
    margin-bottom: 0.35rem;
  }
  .outcomes p {
    margin: 0;
  }
  .industries {
    padding-block: 4rem 0;
  }
  .testimonials {
    padding-block: 3rem 0;
  }
  .quotes {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  figure {
    margin: 0;
    padding: 1.25rem;
    background: var(--white);
    border-radius: var(--radius);
  }
  blockquote {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
  }
  figcaption {
    font-weight: 500;
  }
</style>
