---
import Base from "../layouts/Base.astro";
import { stages } from "../data/stages";
import { formConfig, site } from "../site";

const whatsappLink = site.whatsappNumber ? `https://wa.me/${site.whatsappNumber}` : null;

// Quick picks for step 2. The ones ticked are sent in the "biggest headache" text.
const pains = [
  "Missed calls and messages",
  "No-shows and late cancellations",
  "People can't find us online",
  "Quotes and invoices take too long",
  "Too much paperwork and spreadsheets",
  "Juggling staff, stock or bookings",
];
---

<Base title="Get started" description="Tell us about your business and where it is now. We'll recommend where to start.">
  <section class="container intro">
    <h1>Get started</h1>
    <p>
      Tell us a little about your business. We'll get back to you with honest advice on where to start, in plain
      language.
      {whatsappLink && (
        <>
          Prefer to chat? <a href={whatsappLink}>Message us on WhatsApp</a>.
        </>
      )}
    </p>
  </section>

  <section class="container">
    <form
      id="enquiry"
      class="card"
      novalidate
      data-functions-url={formConfig.functionsUrl}
      data-turnstile-site-key={formConfig.turnstileSiteKey}
    >
      <!-- Filled in by the script; without JavaScript every step shows at once. -->
      <ol class="progress" id="progress" hidden></ol>
      <p class="visually-hidden" id="step-status" aria-live="polite"></p>

      <fieldset class="step" data-step="Your business">
        <legend tabindex="-1"><span class="step-num"></span>Where is your business now?</legend>
        <p class="hint">Pick the one that sounds most like you.</p>
        <div class="choices stages">
          {
            stages.map((s) => (
              <label class="choice">
                <input type="radio" name="stage_needed" value={s.number} />
                <span class="choice-num" aria-hidden="true">{s.number}</span>
                <span>
                  <strong>{s.name}</strong>
                  <small>"{s.whereYouAre}"</small>
                </span>
              </label>
            ))
          }
          <label class="choice">
            <input type="radio" name="stage_needed" value="" checked />
            <span class="choice-num" aria-hidden="true">?</span>
            <span><strong>I'm not sure yet</strong><small>We'll help you work it out</small></span>
          </label>
        </div>

        <div class="field" id="industry-field" hidden>
          <p class="label" id="industry-label">What kind of business is it?</p>
          <div class="pills" role="radiogroup" aria-labelledby="industry-label" id="industries"></div>
        </div>
      </fieldset>

      <fieldset class="step" data-step="Your headache">
        <legend tabindex="-1"><span class="step-num"></span>What's giving you the biggest headache?</legend>
        <p class="hint">Tap any that sound familiar.</p>
        <div class="pills" id="pains">
          {
            pains.map((p) => (
              <label class="pill">
                <input type="checkbox" name="pain" value={p} />
                <span>{p}</span>
              </label>
            ))
          }
        </div>
        <div class="field">
          <label for="biggest_pain">Anything else? Tell us in your own words (optional)</label>
          <textarea id="biggest_pain" name="biggest_pain" rows="3" maxlength="1500"></textarea>
        </div>
      </fieldset>

      <fieldset class="step" data-step="Assessment" id="slots-field" hidden data-skip>
        <legend tabindex="-1"><span class="step-num"></span>Want a free AI Readiness Assessment?</legend>
        <p class="hint">
          Best for businesses that already run on a system and want to automate. Pick a time and we'll come to you, or
          meet online.
        </p>
        <div class="choices slots" id="slots">
          <label class="choice">
            <input type="radio" name="booking_slot_id" value="" checked />
            <span><strong>Not now, thanks</strong><small>You can always book one later</small></span>
          </label>
        </div>
      </fieldset>

      <fieldset class="step" data-step="Your details">
        <legend tabindex="-1"><span class="step-num"></span>How can we reach you?</legend>
        <div class="field">
          <label for="full_name">Your name <span class="req">required</span></label>
          <input id="full_name" name="full_name" autocomplete="name" required maxlength="120" />
        </div>

        <div class="field">
          <label for="business_name">Business name</label>
          <input id="business_name" name="business_name" autocomplete="organization" maxlength="160" />
        </div>

        <div class="row">
          <div class="field">
            <label for="phone">Phone or WhatsApp number <span class="req">required</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required inputmode="tel" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" />
          </div>
        </div>

        <div class="field checks">
          <label class="check">
            <input type="checkbox" name="consent" required />
            <span>
              I agree that IsangoTech may use these details to reply to my enquiry, as explained in the
              <a href="/privacy" target="_blank">privacy policy</a>. <span class="req">required</span>
            </span>
          </label>
          <label class="check">
            <input type="checkbox" name="whatsapp_opt_in" />
            <span>You may contact me on WhatsApp.</span>
          </label>
        </div>

        <!-- Honeypot: hidden from people, filled in by bots. -->
        <div class="hp" aria-hidden="true">
          <label for="website">Leave this empty</label>
          <input id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div id="turnstile" class="turnstile"></div>
      </fieldset>

      <p id="form-error" class="error" role="alert" tabindex="-1" hidden></p>

      <div class="nav">
        <button class="back" type="button" id="back" hidden>← Back</button>
        <button class="button" type="button" id="next" hidden>Next <span class="arrow" aria-hidden="true">→</span></button>
        <button class="button" type="submit" id="submit">Send</button>
      </div>
    </form>

    <div id="success" class="card success" hidden tabindex="-1">
      <svg class="tick" viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
        <circle cx="32" cy="32" r="28" fill="none" stroke="#2BA8A0" stroke-width="4" />
        <path d="M20 33l8 8 16-18" fill="none" stroke="#E07A1F" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <h2>Thank you, we've got it.</h2>
      <p id="success-text">We'll be in touch soon.</p>
      <p><a href="/">Back to the home page</a></p>
    </div>

    <div id="unavailable" class="card" hidden>
      <h2>The form isn't available right now</h2>
      <p>
        {
          whatsappLink ? (
            <>
              Please <a href={whatsappLink}>message us on WhatsApp</a> instead, and we'll help you from there.
            </>
          ) : (
            <>Please try again a little later.</>
          )
        }
      </p>
    </div>
  </section>
</Base>

<script>
  type Slot = { id: string; starts_at: string; ends_at: string; mode: "in_person" | "online" };
  type Options = { industries: { id: string; name: string }[]; slots: Slot[]; privacy_policy_version: string };

  declare global {
    interface Window {
      turnstile?: { reset(el?: string | HTMLElement): void; render(el: string | HTMLElement, opts: object): string };
      onTurnstileLoad?: () => void;
    }
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>("enquiry");
  const functionsUrl = form.dataset.functionsUrl?.replace(/\/$/, "") ?? "";
  const siteKey = form.dataset.turnstileSiteKey ?? "";
  const errorBox = $<HTMLParagraphElement>("form-error");
  const submit = $<HTMLButtonElement>("submit");
  const next = $<HTMLButtonElement>("next");
  const back = $<HTMLButtonElement>("back");
  const progress = $<HTMLOListElement>("progress");
  const status = $<HTMLParagraphElement>("step-status");
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let turnstileToken = "";
  let turnstileLoaded = false;

  const timeFormat = new Intl.DateTimeFormat("en-ZA", {
    timeZone: "Africa/Johannesburg",
    weekday: "long",
    day: "numeric",
    month: "long",
    hour: "2-digit",
    minute: "2-digit",
  });

  function showError(message: string) {
    errorBox.textContent = message;
    errorBox.hidden = false;
    errorBox.focus();
  }

  function unavailable() {
    form.hidden = true;
    $("unavailable").hidden = false;
  }

  // ---- Steps -------------------------------------------------------------
  // The form is one long page without JavaScript. With it, one step shows at
  // a time. Steps marked data-skip (the assessment, when there are no times
  // to book) are left out.
  const allSteps = [...form.querySelectorAll<HTMLFieldSetElement>(".step")];
  let current = 0;

  const steps = () => allSteps.filter((s) => !("skip" in s.dataset));

  function renderProgress() {
    const list = steps();
    progress.style.setProperty("--done", String(list.length > 1 ? current / (list.length - 1) : 1));
    progress.replaceChildren(
      ...list.map((s, i) => {
        const li = document.createElement("li");
        li.className = i < current ? "done" : i === current ? "current" : "";
        if (i === current) li.setAttribute("aria-current", "step");
        li.innerHTML = `<span class="dot">${i < current ? "✓" : i + 1}</span><span class="name"></span>`;
        (li.querySelector(".name") as HTMLElement).textContent = s.dataset.step ?? "";
        return li;
      }),
    );
  }

  function show(index: number, { focus = true } = {}) {
    const list = steps();
    const forward = index > current;
    current = Math.max(0, Math.min(index, list.length - 1));
    for (const s of allSteps) {
      const on = s === list[current];
      s.hidden = !on;
      s.classList.remove("enter-forward", "enter-back");
      if (on && focus && !reduceMotion) s.classList.add(forward ? "enter-forward" : "enter-back");
    }
    list.forEach((s, i) => {
      const num = s.querySelector(".step-num");
      if (num) num.textContent = `Step ${i + 1} of ${list.length}`;
    });
    const last = current === list.length - 1;
    back.hidden = current === 0;
    next.hidden = last;
    submit.hidden = !last;
    errorBox.hidden = true;
    renderProgress();
    status.textContent = `Step ${current + 1} of ${list.length}: ${list[current].dataset.step}`;
    if (last && siteKey && !turnstileLoaded) loadTurnstile();
    if (focus) {
      // Bring the top of the form back into view if the person had scrolled past it.
      if (form.getBoundingClientRect().top < 80) form.scrollIntoView({ block: "start", behavior: reduceMotion ? "auto" : "smooth" });
      list[current].querySelector<HTMLElement>("legend")?.focus({ preventScroll: true });
    }
  }

  function startSteps() {
    form.classList.add("stepped");
    progress.hidden = false;
    show(0, { focus: false });
  }

  next.addEventListener("click", () => show(current + 1));
  form.addEventListener("input", () => (errorBox.hidden = true));
  back.addEventListener("click", () => show(current - 1));

  // Picking a stage card is a natural "next": nudge the button so people see it.
  form.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.type === "radio" && !reduceMotion) {
      next.classList.remove("nudge");
      void next.offsetWidth;
      next.classList.add("nudge");
    }
  });

  // Pre-select the stage chosen on the home page (/get-started?stage=2).
  const stageParam = new URLSearchParams(location.search).get("stage");
  if (stageParam) {
    const radio = form.querySelector<HTMLInputElement>(`input[name="stage_needed"][value="${CSS.escape(stageParam)}"]`);
    if (radio) radio.checked = true;
  }

  // ---- Options from the database -------------------------------------------
  function choice(name: string, value: string, title: string, detail?: string, cls = "pill") {
    const label = document.createElement("label");
    label.className = cls;
    const input = document.createElement("input");
    input.type = "radio";
    input.name = name;
    input.value = value;
    const text = document.createElement("span");
    const strong = document.createElement(cls === "pill" ? "span" : "strong");
    strong.textContent = title;
    text.append(strong);
    if (detail) {
      const small = document.createElement("small");
      small.textContent = detail;
      text.append(small);
    }
    label.append(input, text);
    return label;
  }

  async function loadOptions() {
    const res = await fetch(`${functionsUrl}/enquiry-options`);
    if (!res.ok) throw new Error(`enquiry-options ${res.status}`);
    const options = (await res.json()) as Options;

    const industries = $("industries");
    if (!industries.childElementCount) {
      for (const i of options.industries) industries.append(choice("industry_id", i.id, i.name));
    }
    $("industry-field").hidden = options.industries.length === 0;

    const slots = $("slots");
    slots.querySelectorAll(".slot").forEach((el) => el.remove());
    const none = slots.querySelector<HTMLInputElement>("input")!;
    none.checked = true;
    for (const s of options.slots) {
      const where = s.mode === "online" ? "Online" : "In person";
      slots.append(choice("booking_slot_id", s.id, timeFormat.format(new Date(s.starts_at)), where, "choice slot"));
    }
    const slotStep = $("slots-field");
    const wasOn = !("skip" in slotStep.dataset);
    if (options.slots.length) delete slotStep.dataset.skip;
    else slotStep.dataset.skip = "";
    // Keep the person on the step they're on if the step list changed.
    if (form.classList.contains("stepped") && wasOn !== !("skip" in slotStep.dataset)) {
      const on = allSteps.find((s) => !s.hidden);
      show(Math.max(0, steps().indexOf(on!)), { focus: false });
    } else if (!form.classList.contains("stepped")) {
      slotStep.hidden = options.slots.length === 0;
    }
  }

  function loadTurnstile() {
    turnstileLoaded = true;
    window.onTurnstileLoad = () => {
      window.turnstile!.render("#turnstile", {
        sitekey: siteKey,
        callback: (token: string) => (turnstileToken = token),
        "expired-callback": () => (turnstileToken = ""),
      });
    };
    const script = document.createElement("script");
    script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoad&render=explicit";
    script.async = true;
    document.head.append(script);
  }

  // ---- Sending -------------------------------------------------------------
  function validate(): string | null {
    const data = new FormData(form);
    if (!String(data.get("full_name") ?? "").trim()) return "Please tell us your name.";
    const phoneDigits = String(data.get("phone") ?? "").replace(/[^0-9+]/g, "");
    if (phoneDigits.length < 9) return "Please give a phone number we can reach you on.";
    const email = String(data.get("email") ?? "").trim();
    if (email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return "That email address doesn't look right.";
    if (!data.get("consent")) return "Please agree to the privacy policy so we can reply to you.";
    if (siteKey && !turnstileToken) return "Please complete the spam check.";
    return null;
  }

  /** The ticked quick picks plus the person's own words, as one note. */
  function biggestPain(data: FormData) {
    const picks = data.getAll("pain").map(String);
    const own = String(data.get("biggest_pain") ?? "").trim();
    return [picks.length ? picks.join("; ") + "." : "", own].filter(Boolean).join(" ").slice(0, 2000);
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    // Enter on an earlier step moves on rather than sending.
    if (form.classList.contains("stepped") && current < steps().length - 1) return show(current + 1);
    errorBox.hidden = true;
    const problem = validate();
    if (problem) return showError(problem);

    const data = new FormData(form);
    const stage = String(data.get("stage_needed") ?? "");
    const body = {
      full_name: String(data.get("full_name")).trim(),
      business_name: String(data.get("business_name") ?? "").trim(),
      industry_id: String(data.get("industry_id") ?? ""),
      phone: String(data.get("phone")).trim(),
      email: String(data.get("email") ?? "").trim(),
      stage_needed: stage ? Number(stage) : null,
      biggest_pain: biggestPain(data),
      booking_slot_id: String(data.get("booking_slot_id") ?? ""),
      consent: data.get("consent") === "on",
      whatsapp_opt_in: data.get("whatsapp_opt_in") === "on",
      website: String(data.get("website") ?? ""),
      turnstile_token: turnstileToken,
    };

    submit.disabled = true;
    submit.textContent = "Sending…";
    try {
      const res = await fetch(`${functionsUrl}/submit-enquiry`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const result = await res.json().catch(() => ({}));
      if (res.ok) {
        form.hidden = true;
        const success = $("success");
        if (result.assessment_starts_at) {
          $("success-text").textContent =
            `Your AI Readiness Assessment is booked for ${timeFormat.format(new Date(result.assessment_starts_at))}. ` +
            "We'll confirm the details with you before then.";
        }
        success.hidden = false;
        success.focus({ preventScroll: true });
        success.scrollIntoView({ block: "center", behavior: reduceMotion ? "auto" : "smooth" });
        return;
      }
      if (res.status === 409) {
        // That time was just taken: refresh the times and go back to pick another.
        await loadOptions().catch(() => {});
        const slotStep = steps().indexOf($("slots-field") as HTMLFieldSetElement);
        if (slotStep >= 0) show(slotStep);
      }
      showError(result.error ?? "Something went wrong. Please try again.");
    } catch {
      showError("We couldn't send your details. Please check your connection and try again.");
    } finally {
      submit.disabled = false;
      submit.textContent = "Send";
      // Only once the Turnstile script is in: before that, window.turnstile is the #turnstile element.
      if (turnstileLoaded && typeof window.turnstile?.reset === "function") window.turnstile.reset("#turnstile");
      turnstileToken = "";
    }
  });

  if (!functionsUrl) {
    unavailable();
  } else {
    startSteps();
    loadOptions().catch(() => {
      // The form still works without industries and slots.
    });
  }
</script>

<style>
  .intro {
    padding-block: 3rem 1.5rem;
  }
  .intro > * {
    max-width: 44rem;
  }
  .card {
    scroll-margin-top: 6rem;
    max-width: 44rem;
    padding: clamp(1.25rem, 4vw, 2.25rem);
    box-shadow: 0 20px 40px -24px rgb(27 42 74 / 0.35);
    background: var(--white);
    border-radius: var(--radius);
  }
  .field {
    margin: 0 0 1.25rem;
    border: 0;
    padding: 0;
  }
  label,
  legend {
    display: block;
    font-weight: 500;
    margin-bottom: 0.35rem;
  }
  .req {
    font-weight: 400;
    font-size: 0.8rem;
    color: var(--terracotta);
  }
  input:not([type="radio"], [type="checkbox"]),
  select,
  textarea {
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 1.5px solid rgb(27 42 74 / 0.3);
    border-radius: 0.5rem;
    font: inherit;
    color: inherit;
    background: var(--white);
  }
  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--turquoise);
    outline: none;
    box-shadow: 0 0 0 3px rgb(43 168 160 / 0.25);
  }
  .row {
    display: grid;
    gap: 0 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .choices {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 40rem) {
    .stages,
    .slots {
      grid-template-columns: 1fr 1fr;
    }
  }
  #enquiry :global(.choice) {
    position: relative;
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 0.9rem 1rem;
    border: 1.5px solid rgb(27 42 74 / 0.15);
    border-radius: 0.75rem;
    font-weight: 400;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease-out),
      background 0.2s var(--ease-out),
      transform 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
  }
  #enquiry :global(.choice:hover) {
    border-color: rgb(43 168 160 / 0.6);
    transform: translateY(-2px);
    box-shadow: 0 8px 18px -10px rgb(27 42 74 / 0.35);
  }
  #enquiry :global(.choice:has(input:checked)) {
    border-color: var(--turquoise);
    background: rgb(43 168 160 / 0.08);
    box-shadow: 0 0 0 1px var(--turquoise);
  }
  #enquiry :global(.choice:has(input:focus-visible)),
  #enquiry :global(.pill:has(input:focus-visible)) {
    outline: 3px solid var(--turquoise);
    outline-offset: 2px;
  }
  /* The real radio stays in the page for keyboards and screen readers. */
  #enquiry :global(.choice input),
  #enquiry :global(.pill input) {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  #enquiry :global(.choice-num) {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    font: 700 1rem/1 var(--font-heading);
    background: var(--sand);
    color: var(--indigo);
    transition:
      background 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  #enquiry :global(.choice:has(input:checked) .choice-num) {
    background: var(--ochre);
    color: var(--white);
    transform: scale(1.1);
  }
  #enquiry :global(.choice span:not(.choice-num)) {
    display: grid;
    gap: 0.15rem;
  }
  #enquiry :global(.choice strong) {
    font-weight: 500;
  }
  #enquiry :global(.choice small) {
    font-size: 0.9rem;
    opacity: 0.85;
  }
  #enquiry :global(.slot strong) {
    font-weight: 500;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  #enquiry :global(.pill) {
    position: relative;
    margin: 0;
    padding: 0.55rem 1rem;
    border: 1.5px solid rgb(27 42 74 / 0.2);
    border-radius: 999px;
    font-weight: 400;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease-out),
      background 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }
  #enquiry :global(.pill:hover) {
    border-color: var(--turquoise);
  }
  #enquiry :global(.pill:has(input:checked)) {
    background: var(--indigo);
    border-color: var(--indigo);
    color: var(--white);
  }
  #enquiry :global(.pill:has(input[type="checkbox"]:checked) span::before) {
    content: "✓ ";
    color: var(--ochre);
  }
  #enquiry :global(.pill:active) {
    transform: scale(0.96);
  }
  .label {
    font-weight: 500;
    margin: 0 0 0.5rem;
  }
  .check {
    display: flex;
    gap: 0.75rem;
    font-weight: 400;
    margin-bottom: 0.75rem;
  }
  .check input {
    flex: none;
    margin-top: 0.3rem;
    accent-color: var(--turquoise-text);
  }
  .check span {
    display: block;
  }

  /* ---- Steps ---- */
  .step {
    margin: 0 0 1.5rem;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .step legend {
    padding: 0;
    margin-bottom: 0.5rem;
    font: 700 clamp(1.35rem, 3.5vw, 1.7rem) / 1.2 var(--font-heading);
