---
import Base from "../layouts/Base.astro";
import { stagesFor } from "../data/stages";
import { formConfig, site } from "../site";
import { langOf, localize, pick } from "../i18n";

const lang = langOf(Astro.url);
const L = (path: string) => localize(path, lang);
const stages = stagesFor(lang);
const whatsappLink = site.whatsappNumber ? `https://wa.me/${site.whatsappNumber}` : null;

// Quick picks for step 2. The ones ticked are sent in the "biggest headache"
// text, always in English so the portal's leads read the same.
const painsEn = [
  "Missed calls and messages",
  "No-shows and late cancellations",
  "People can't find us online",
  "Quotes and invoices take too long",
  "Too much paperwork and spreadsheets",
  "Juggling staff, stock or bookings",
];
const painsXh = [
  "Iminxeba nemiyalezo ephosiweyo",
  "Abangafikiyo nabarhoxisa emva kwexesha",
  "Abantu abasifumani kwi-intanethi",
  "Iikowuti nee-invoyisi zithatha ixesha elide",
  "Amaphepha amaninzi nee-spreadsheet",
  "Ukulawula abasebenzi, isitokhwe okanye ii-booking",
];
const pains = painsEn.map((value, i) => ({ value, label: lang === "xh" ? painsXh.at(i)! : value }));

const w = pick(lang, {
  en: {
    title: "Get started",
    description: "Tell us about your business in a few quick steps. We'll get back to you with honest advice on where to start.",
    lead: "Tell us a little about your business. We'll get back to you with honest advice on where to start, in plain language.",
    chat: "Prefer to chat?",
    chatLink: "Message us on WhatsApp",
    founding: "You're asking about the <strong>founding client offer</strong>: up to 40% off setup for our first five clients.",
    stepBusiness: "Your business",
    whereNow: "Where is your business now?",
    pickOne: "Pick the one that sounds most like you.",
    notSure: "I'm not sure yet",
    notSureHelp: "We'll help you work it out",
    industry: "What kind of business is it?",
    stepHeadache: "Your headache",
    headache: "What's giving you the biggest headache?",
    tapAny: "Tap any that sound familiar.",
    anythingElse: "Anything else? Tell us in your own words (optional)",
    stepAssessment: "Assessment",
    assessment: "Want an AI Readiness Assessment?",
    assessmentHint: "For businesses already running on a website or system that want to automate. R1 500, credited against your project if you go ahead. Pick a time and we'll come to you, or meet online.",
    notNow: "Not now, thanks",
    later: "You can always book one later",
    stepDetails: "Your details",
    reach: "How can we reach you?",
    name: "Your name",
    required: "required",
    business: "Business name",
    phone: "Phone or WhatsApp number",
    email: "Email",
    consent: `I agree that IsangoTech may use these details to reply to my enquiry, as explained in the <a href="${L("/privacy")}" target="_blank">privacy policy</a>.`,
    whatsappOk: "You may contact me on WhatsApp.",
    honeypot: "Leave this empty",
    back: "← Back",
    next: "Next",
    send: "Send",
    thanks: "Thank you, we've got it.",
    soon: "We'll reply within 1 working day: on WhatsApp if you said we may, otherwise by phone or email.",
    whatNext: "We reply within 1 working day.",
    home: "Back to the home page",
    unavailable: "The form isn't available right now",
    unavailableWa: "Please <a href=\"%WA%\">message us on WhatsApp</a> instead, and we'll help you from there.",
    unavailableLater: "Please try again a little later.",
  },
  xh: {
    title: "Qalisa",
    description: "Sixelele ngeshishini lakho ngamanyathelo ambalwa akhawulezayo. Siza kukuphendula ngengcebiso ethembekileyo malunga nendawo yokuqala.",
    lead: "Sixelele kancinci ngeshishini lakho. Siza kukuphendula ngengcebiso ethembekileyo malunga nendawo yokuqala, ngolwimi olucacileyo.",
    chat: "Ukhetha ukuncokola?",
    chatLink: "Sithumelele umyalezo kwi-WhatsApp",
    founding: "Ubuza <strong>ngesaphulelo sabathengi bokuqala</strong>: ukuya kwi-40% kwintlawulo yokuseta kubathengi bethu abahlanu bokuqala.",
    stepBusiness: "Ishishini lakho",
    whereNow: "Likweyiphi inqanaba ishishini lakho ngoku?",
    pickOne: "Khetha elivakala ngathi lelakho.",
    notSure: "Andiqinisekanga okwangoku",
    notSureHelp: "Siza kukunceda ufumanise",
    industry: "Lishishini lohlobo luni?",
    stepHeadache: "Ingxaki yakho",
    headache: "Yeyiphi eyona ngxaki ikukhathazayo?",
    tapAny: "Cofa nayiphi na evakala iqhelekile kuwe.",
    anythingElse: "Ikhona enye into? Sixelele ngamazwi akho (ukuba uyathanda)",
    stepAssessment: "Uvavanyo",
    assessment: "Ufuna i-AI Readiness Assessment?",
    assessmentHint: "Yamashishini asele esebenzisa i-website okanye inkqubo afuna i-automation. Yi-R1 500, ibalelwa kwiprojekthi yakho ukuba uyaqhubeka. Khetha ixesha kwaye siza kuza kuwe, okanye sidibane kwi-intanethi.",
    notNow: "Hayi okwangoku, enkosi",
    later: "Ungabhukisha kamva nanini na",
    stepDetails: "Iinkcukacha zakho",
    reach: "Singakufumana njani?",
    name: "Igama lakho",
    required: "iyafuneka",
    business: "Igama leshishini",
    phone: "Inombolo yefowuni okanye ye-WhatsApp",
    email: "I-imeyile",
    consent: `Ndiyavuma ukuba i-IsangoTech ingasebenzisa ezi nkcukacha ukuphendula umbuzo wam, njengoko kuchaziwe <a href="${L("/privacy")}" target="_blank">kumgaqo-nkqubo wabucala</a>.`,
    whatsappOk: "Ningaqhagamshelana nam kwi-WhatsApp.",
    honeypot: "Shiya oku kungenanto",
    back: "← Buyela umva",
    next: "Okulandelayo",
    send: "Thumela",
    thanks: "Enkosi, siyifumene.",
    soon: "Siza kuphendula kungadlulanga usuku olu-1 lomsebenzi: kwi-WhatsApp ukuba uvumile, kungenjalo ngomnxeba okanye nge-imeyile.",
    whatNext: "Siphendula kungadlulanga usuku olu-1 lomsebenzi.",
    home: "Buyela ekhaya",
    unavailable: "Ifomu ayifumaneki okwangoku",
    unavailableWa: "Nceda <a href=\"%WA%\">usithumelele umyalezo kwi-WhatsApp</a> endaweni yoko, kwaye siza kukunceda ukusuka apho.",
    unavailableLater: "Nceda uzame kwakhona emva kwexesha elincinci.",
  },
});
---

<Base title={w.title} description={w.description}>
  <section class="container intro">
    <h1>{w.title}</h1>
    <p>
      {w.lead} {w.whatNext}
      {whatsappLink && (
        <>
          {w.chat} <a href={whatsappLink}>{w.chatLink}</a>.
        </>
      )}
    </p>
  </section>

  <section class="container">
    <form
      id="enquiry"
      class="card"
      novalidate
      data-functions-url={formConfig.functionsUrl}
      data-turnstile-site-key={formConfig.turnstileSiteKey}
    >
      <p class="founding-note" id="founding-note" hidden set:html={w.founding} />
      <!-- Filled in by the script; without JavaScript every step shows at once. -->
      <ol class="progress" id="progress" hidden></ol>
      <p class="visually-hidden" id="step-status" aria-live="polite"></p>

      <fieldset class="step" data-step={w.stepBusiness}>
        <legend tabindex="-1"><span class="step-num"></span>{w.whereNow}</legend>
        <p class="hint">{w.pickOne}</p>
        <div class="choices stages">
          {
            stages.map((s) => (
              <label class="choice">
                <input type="radio" name="stage_needed" value={s.number} />
                <span class="choice-num" aria-hidden="true">{s.number}</span>
                <span>
                  <strong>{s.name}</strong>
                  <small>"{s.whereYouAre}"</small>
                </span>
              </label>
            ))
          }
          <label class="choice">
            <input type="radio" name="stage_needed" value="" checked />
            <span class="choice-num" aria-hidden="true">?</span>
            <span><strong>{w.notSure}</strong><small>{w.notSureHelp}</small></span>
          </label>
        </div>

        <div class="field" id="industry-field" hidden>
          <p class="label" id="industry-label">{w.industry}</p>
          <div class="pills" role="radiogroup" aria-labelledby="industry-label" id="industries"></div>
        </div>
      </fieldset>

      <fieldset class="step" data-step={w.stepHeadache}>
        <legend tabindex="-1"><span class="step-num"></span>{w.headache}</legend>
        <p class="hint">{w.tapAny}</p>
        <div class="pills" id="pains">
          {
            pains.map((p) => (
              <label class="pill">
                <input type="checkbox" name="pain" value={p.value} />
                <span>{p.label}</span>
              </label>
            ))
          }
        </div>
        <div class="field">
          <label for="biggest_pain">{w.anythingElse}</label>
          <textarea id="biggest_pain" name="biggest_pain" rows="3" maxlength="1500"></textarea>
        </div>
      </fieldset>

      <fieldset class="step" data-step={w.stepAssessment} id="slots-field" hidden data-skip>
        <legend tabindex="-1"><span class="step-num"></span>{w.assessment}</legend>
        <p class="hint">{w.assessmentHint}</p>
        <div class="choices slots" id="slots">
          <label class="choice">
            <input type="radio" name="booking_slot_id" value="" checked />
            <span><strong>{w.notNow}</strong><small>{w.later}</small></span>
          </label>
        </div>
      </fieldset>

      <fieldset class="step" data-step={w.stepDetails}>
        <legend tabindex="-1"><span class="step-num"></span>{w.reach}</legend>
        <div class="field">
          <label for="full_name">{w.name} <span class="req">{w.required}</span></label>
          <input id="full_name" name="full_name" autocomplete="name" required maxlength="120" />
        </div>

        <div class="field">
          <label for="business_name">{w.business}</label>
          <input id="business_name" name="business_name" autocomplete="organization" maxlength="160" />
        </div>

        <div class="row">
          <div class="field">
            <label for="phone">{w.phone} <span class="req">{w.required}</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required inputmode="tel" />
          </div>
          <div class="field">
            <label for="email">{w.email}</label>
            <input id="email" name="email" type="email" autocomplete="email" />
          </div>
        </div>

        <div class="field checks">
          <label class="check">
            <input type="checkbox" name="consent" required />
            <span>
              <Fragment set:html={w.consent} /> <span class="req">{w.required}</span>
            </span>
          </label>
          <label class="check">
            <input type="checkbox" name="whatsapp_opt_in" />
            <span>{w.whatsappOk}</span>
          </label>
        </div>

        <!-- Honeypot: hidden from people, filled in by bots. -->
        <div class="hp" aria-hidden="true">
          <label for="website">{w.honeypot}</label>
          <input id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div id="turnstile" class="turnstile"></div>
      </fieldset>

      <p id="form-error" class="error" role="alert" tabindex="-1" hidden></p>

      <div class="nav">
        <button class="back" type="button" id="back" hidden>{w.back}</button>
        <button class="button" type="button" id="next" hidden>{w.next} <span class="arrow" aria-hidden="true">→</span></button>
        <button class="button" type="submit" id="submit">{w.send}</button>
      </div>
    </form>

    <div id="success" class="card success" hidden tabindex="-1">
      <svg class="tick" viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
        <circle cx="32" cy="32" r="28" fill="none" stroke="#2BA8A0" stroke-width="4" />
        <path d="M20 33l8 8 16-18" fill="none" stroke="#E07A1F" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <h2>{w.thanks}</h2>
      <p id="success-text">{w.soon}</p>
      <p><a href={L("/")}>{w.home}</a></p>
    </div>

    <div id="unavailable" class="card" hidden>
      <h2>{w.unavailable}</h2>
      <p set:html={whatsappLink ? w.unavailableWa.replace("%WA%", whatsappLink) : w.unavailableLater} />
    </div>
  </section>
</Base>

<script>
  type Slot = { id: string; starts_at: string; ends_at: string; mode: "in_person" | "online" };
  type Options = { industries: { id: string; name: string }[]; slots: Slot[]; privacy_policy_version: string };

  declare global {
    interface Window {
      turnstile?: { reset(el?: string | HTMLElement): void; render(el: string | HTMLElement, opts: object): string };
      onTurnstileLoad?: () => void;
    }
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>("enquiry");
  const functionsUrl = form.dataset.functionsUrl?.replace(/\/$/, "") ?? "";
  const siteKey = form.dataset.turnstileSiteKey ?? "";
  const errorBox = $<HTMLParagraphElement>("form-error");
  const submit = $<HTMLButtonElement>("submit");
  const next = $<HTMLButtonElement>("next");
  const back = $<HTMLButtonElement>("back");
  const progress = $<HTMLOListElement>("progress");
  const status = $<HTMLParagraphElement>("step-status");
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let turnstileToken = "";
  let turnstileLoaded = false;

  // The page's language decides the words the script shows.
  const xh = document.documentElement.lang.startsWith("xh");
  const t = xh
    ? {
        step: (i: number, n: number) => `Inyathelo ${i}/${n}`,
        online: "Kwi-intanethi",
        inPerson: "Ebusweni",
        noName: "Nceda usixelele igama lakho.",
        noPhone: "Nceda unike inombolo yefowuni esinokukufumana kuyo.",
        badEmail: "Le dilesi ye-imeyile ayibonakali ichanekile.",
        noConsent: "Nceda uvume umgaqo-nkqubo wabucala ukuze sikwazi ukukuphendula.",
        noSpamCheck: "Nceda ugqibe uvavanyo lwe-spam.",
        sending: "Iyathumela…",
        send: "Thumela",
        booked: (when: string) => `I-AI Readiness Assessment yakho ibhukishelwe ${when}. Siza kuqinisekisa iinkcukacha nawe ngaphambi koko.`,
        failed: "Kukho into engahambanga kakuhle. Nceda uzame kwakhona.",
        offline: "Asikwazanga ukuthumela iinkcukacha zakho. Nceda ujonge uqhagamshelwano lwakho uzame kwakhona.",
      }
    : {
        step: (i: number, n: number) => `Step ${i} of ${n}`,
        online: "Online",
        inPerson: "In person",
        noName: "Please tell us your name.",
        noPhone: "Please give a phone number we can reach you on.",
        badEmail: "That email address doesn't look right.",
        noConsent: "Please agree to the privacy policy so we can reply to you.",
        noSpamCheck: "Please complete the spam check.",
        sending: "Sending…",
        send: "Send",
        booked: (when: string) => `Your AI Readiness Assessment is booked for ${when}. We'll confirm the details with you before then.`,
        failed: "Something went wrong. Please try again.",
        offline: "We couldn't send your details. Please check your connection and try again.",
      };
  // Industry names come from the database in English.
  const industryXh: Record<string, string> = {
    "Salons and beauty": "Iisalon nezobuhle",
    "Restaurants and food businesses": "Iirestyu namashishini okutya",
    Caterers: "Abapheki beminyhadala",
    "Caterers and event companies": "Abapheki namashishini eminyhadala",
    "Auto repair shops": "Iigaraji zokulungisa iimoto",
    "Cleaning and security": "Ococeko nezokhuseleko",
    "Tutoring centres": "Amaziko okufundisa",
    "Gyms and fitness": "Iijim nokuzilolonga",
    "Guesthouses and B&Bs": "Iindlu zeendwendwe nee-B&B",
    "Construction and trades": "Ukwakha nezakhono zezandla",
    "Professional services": "Iinkonzo zobungcali",
    Retail: "Iivenkile",
    "Other small business": "Elinye ishishini elincinci",
  };

  // Browsers have no isiXhosa dates built in, so isiXhosa times are written here,
  // in South African time (UTC+2, no daylight saving): "ngoLwesithathu, 14 kweyeDwarha ngo-10:00".
  const xhDays = ["ngeCawe", "ngoMvulo", "ngoLwesibini", "ngoLwesithathu", "ngoLwesine", "ngoLwesihlanu", "ngoMgqibelo"];
  const xhMonths = ["kweyoMqungu", "kweyoMdumba", "kweyoKwindla", "kweyoTshazimpuzi", "kweyoCanzibe", "kweyeSilimela", "kweyeKhala", "kweyeThupha", "kweyoMsintsi", "kweyeDwarha", "kweyeNkanga", "kweyoMnga"];
  const xhTime = (d: Date) => {
    const sa = new Date(d.getTime() + 2 * 3600e3);
    const hh = String(sa.getUTCHours()).padStart(2, "0"), mm = String(sa.getUTCMinutes()).padStart(2, "0");
    return `${xhDays.at(sa.getUTCDay())}, ${sa.getUTCDate()} ${xhMonths.at(sa.getUTCMonth())} ngo-${hh}:${mm}`;
  };
  const enFormat = new Intl.DateTimeFormat("en-ZA", {
    timeZone: "Africa/Johannesburg",
    weekday: "long",
    day: "numeric",
    month: "long",
    hour: "2-digit",
    minute: "2-digit",
  });
  const timeFormat = { format: (d: Date) => (xh ? xhTime(d) : enFormat.format(d)) };

  function showError(message: string) {
    errorBox.textContent = message;
    errorBox.hidden = false;
    errorBox.focus();
  }

  function unavailable() {
    form.hidden = true;
    $("unavailable").hidden = false;
  }

  // ---- Steps -------------------------------------------------------------
  // The form is one long page without JavaScript. With it, one step shows at
  // a time. Steps marked data-skip (the assessment, when there are no times
  // to book) are left out.
  const allSteps = [...form.querySelectorAll<HTMLFieldSetElement>(".step")];
  let current = 0;

  const steps = () => allSteps.filter((s) => !("skip" in s.dataset));

  function renderProgress() {
    const list = steps();
    progress.style.setProperty("--done", String(list.length > 1 ? current / (list.length - 1) : 1));
    progress.replaceChildren(
      ...list.map((s, i) => {
        const li = document.createElement("li");
        li.className = i < current ? "done" : i === current ? "current" : "";
        if (i === current) li.setAttribute("aria-current", "step");
        li.innerHTML = `<span class="dot">${i < current ? "✓" : i + 1}</span><span class="name"></span>`;
        (li.querySelector(".name") as HTMLElement).textContent = s.dataset.step ?? "";
        return li;
      }),
    );
  }

  function show(index: number, { focus = true } = {}) {
    const list = steps();
    const forward = index > current;
    current = Math.max(0, Math.min(index, list.length - 1));
    for (const s of allSteps) {
      const on = s === list[current];
      s.hidden = !on;
      s.classList.remove("enter-forward", "enter-back");
      if (on && focus && !reduceMotion) s.classList.add(forward ? "enter-forward" : "enter-back");
    }
    list.forEach((s, i) => {
      const num = s.querySelector(".step-num");
      if (num) num.textContent = t.step(i + 1, list.length);
    });
    const last = current === list.length - 1;
    back.hidden = current === 0;
    next.hidden = last;
    submit.hidden = !last;
    errorBox.hidden = true;
    renderProgress();
    status.textContent = `${t.step(current + 1, list.length)}: ${list[current].dataset.step}`;
    if (last && siteKey && !turnstileLoaded) loadTurnstile();
    if (focus) {
      // Bring the top of the form back into view if the person had scrolled past it.
      if (form.getBoundingClientRect().top < 80) form.scrollIntoView({ block: "start", behavior: reduceMotion ? "auto" : "smooth" });
      list[current].querySelector<HTMLElement>("legend")?.focus({ preventScroll: true });
    }
  }

  function startSteps() {
    form.classList.add("stepped");
    progress.hidden = false;
    show(0, { focus: false });
  }

  next.addEventListener("click", () => show(current + 1));
  form.addEventListener("input", () => (errorBox.hidden = true));
  back.addEventListener("click", () => show(current - 1));

  // Picking a stage card is a natural "next": nudge the button so people see it.
  form.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.type === "radio" && !reduceMotion) {
      next.classList.remove("nudge");
      void next.offsetWidth;
      next.classList.add("nudge");
    }
  });

  // Pre-select the stage chosen on the home page (/get-started?stage=2).
  const stageParam = new URLSearchParams(location.search).get("stage");
  if (stageParam) {
    const radio = form.querySelector<HTMLInputElement>(`input[name="stage_needed"][value="${CSS.escape(stageParam)}"]`);
    if (radio) radio.checked = true;
  }

  // ---- Options from the database -------------------------------------------
  function choice(name: string, value: string, title: string, detail?: string, cls = "pill") {
    const label = document.createElement("label");
    label.className = cls;
    const input = document.createElement("input");
    input.type = "radio";
    input.name = name;
    input.value = value;
    const text = document.createElement("span");
    const strong = document.createElement(cls === "pill" ? "span" : "strong");
    strong.textContent = title;
    text.append(strong);
    if (detail) {
      const small = document.createElement("small");
      small.textContent = detail;
      text.append(small);
    }
    label.append(input, text);
    return label;
  }

  async function loadOptions() {
    const res = await fetch(`${functionsUrl}/enquiry-options`);
    if (!res.ok) throw new Error(`enquiry-options ${res.status}`);
    const options = (await res.json()) as Options;

    const industries = $("industries");
    if (!industries.childElementCount) {
      for (const i of options.industries) industries.append(choice("industry_id", i.id, (xh && industryXh[i.name]) || i.name));
    }
    $("industry-field").hidden = options.industries.length === 0;

    const slots = $("slots");
    slots.querySelectorAll(".slot").forEach((el) => el.remove());
    const none = slots.querySelector<HTMLInputElement>("input")!;
    none.checked = true;
    for (const s of options.slots) {
      const where = s.mode === "online" ? t.online : t.inPerson;
      slots.append(choice("booking_slot_id", s.id, timeFormat.format(new Date(s.starts_at)), where, "choice slot"));
    }
    const slotStep = $("slots-field");
    const wasOn = !("skip" in slotStep.dataset);
    if (options.slots.length) delete slotStep.dataset.skip;
    else slotStep.dataset.skip = "";
    // Keep the person on the step they're on if the step list changed.
    if (form.classList.contains("stepped") && wasOn !== !("skip" in slotStep.dataset)) {
      const on = allSteps.find((s) => !s.hidden);
      show(Math.max(0, steps().indexOf(on!)), { focus: false });
    } else if (!form.classList.contains("stepped")) {
      slotStep.hidden = options.slots.length === 0;
    }
  }

  function loadTurnstile() {
    turnstileLoaded = true;
    window.onTurnstileLoad = () => {
      window.turnstile!.render("#turnstile", {
        sitekey: siteKey,
        callback: (token: string) => (turnstileToken = token),
        "expired-callback": () => (turnstileToken = ""),
      });
    };
    const script = document.createElement("script");
    script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoad&render=explicit";
    script.async = true;
    document.head.append(script);
  }

  // ---- Sending -------------------------------------------------------------
  function validate(): string | null {
    const data = new FormData(form);
    if (!String(data.get("full_name") ?? "").trim()) return t.noName;
    const phoneDigits = String(data.get("phone") ?? "").replace(/[^0-9+]/g, "");
    if (phoneDigits.length < 9) return t.noPhone;
    const email = String(data.get("email") ?? "").trim();
    if (email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return t.badEmail;
    if (!data.get("consent")) return t.noConsent;
    if (siteKey && !turnstileToken) return t.noSpamCheck;
    return null;
  }

  // Came from "Ask about a founding spot" (/get-started?founding=1).
  const founding = new URLSearchParams(location.search).has("founding");
  if (founding) $("founding-note").hidden = false;

  /** The ticked quick picks plus the person's own words, as one note. */
  function biggestPain(data: FormData) {
    const picks = data.getAll("pain").map(String);
    const own = String(data.get("biggest_pain") ?? "").trim();
    // Notes for the team, in English: an isiXhosa form means reply in isiXhosa.
    return [xh ? "Filled in in isiXhosa." : "", founding ? "Interested in the founding client offer." : "", picks.length ? picks.join("; ") + "." : "", own]
      .filter(Boolean)
      .join(" ")
      .slice(0, 2000);
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    // Enter on an earlier step moves on rather than sending.
    if (form.classList.contains("stepped") && current < steps().length - 1) return show(current + 1);
    errorBox.hidden = true;
    const problem = validate();
    if (problem) return showError(problem);

    const data = new FormData(form);
    const stage = String(data.get("stage_needed") ?? "");
    const body = {
      full_name: String(data.get("full_name")).trim(),
      business_name: String(data.get("business_name") ?? "").trim(),
      industry_id: String(data.get("industry_id") ?? ""),
      phone: String(data.get("phone")).trim(),
      email: String(data.get("email") ?? "").trim(),
      stage_needed: stage ? Number(stage) : null,
      biggest_pain: biggestPain(data),
      booking_slot_id: String(data.get("booking_slot_id") ?? ""),
      consent: data.get("consent") === "on",
      whatsapp_opt_in: data.get("whatsapp_opt_in") === "on",
      website: String(data.get("website") ?? ""),
      turnstile_token: turnstileToken,
    };

    submit.disabled = true;
    submit.textContent = t.sending;
    try {
      const res = await fetch(`${functionsUrl}/submit-enquiry`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const result = await res.json().catch(() => ({}));
      if (res.ok) {
        form.hidden = true;
        const success = $("success");
        if (result.assessment_starts_at) {
          $("success-text").textContent =
            t.booked(timeFormat.format(new Date(result.assessment_starts_at)));
        }
        success.hidden = false;
        success.focus({ preventScroll: true });
        success.scrollIntoView({ block: "center", behavior: reduceMotion ? "auto" : "smooth" });
        return;
      }
      if (res.status === 409) {
        // That time was just taken: refresh the times and go back to pick another.
        await loadOptions().catch(() => {});
        const slotStep = steps().indexOf($("slots-field") as HTMLFieldSetElement);
        if (slotStep >= 0) show(slotStep);
      }
      showError(result.error ?? t.failed);
    } catch {
      showError(t.offline);
    } finally {
      submit.disabled = false;
      submit.textContent = t.send;
      // Only once the Turnstile script is in: before that, window.turnstile is the #turnstile element.
      if (turnstileLoaded && typeof window.turnstile?.reset === "function") window.turnstile.reset("#turnstile");
      turnstileToken = "";
    }
  });

  if (!functionsUrl) {
    unavailable();
  } else {
    startSteps();
    loadOptions().catch(() => {
      // The form still works without industries and slots.
    });
  }
</script>

