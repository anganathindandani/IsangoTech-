---
import Base from "../layouts/Base.astro";
import CallToAction from "../components/CallToAction.astro";
import FoundingOffer from "../components/FoundingOffer.astro";
import { formatPrice, packagesFor } from "../data/packages";
import { site } from "../site";
import { langOf, localize, pick } from "../i18n";

const lang = langOf(Astro.url);
const L = (path: string) => localize(path, lang);
const packages = packagesFor(lang);
const w = pick(lang, {
  en: {
    title: "Services and pricing",
    searchTitle: "Small business websites and prices, East London",
    description: "Starter websites from R3 500 once-off, Google Business Profile setup and optional care plans for small businesses in East London and the Eastern Cape. No monthly fee, and the website is yours.",
    lead: "We get your business found online. Clear prices, written in a quote before any work starts, so you know the full cost upfront.",
    chatHeading: "Not sure what you need? Start with a free chat.",
    chatText: "Tell us about your business and we'll recommend where to start, even if the honest answer is \"you don't need this yet\".",
    chatButton: "Book a free chat",
    start: "Get started",
    addonsHeading: "Just your Google profile",
    addonsLead: "Not ready for a website yet? Start with your Google Business Profile.",
    careHeading: "Care after launch",
    careLead: "Optional. Take a care plan if you'd rather we look after things for you.",
    fixes: "30 days of free fixes",
    fixesText: "After every handover, we fix anything that doesn't work as agreed, at no cost.",
    help: "Help when you need it: R400 an hour",
    helpText: "No care plan? Ask for help any time. We tell you the cost before we start.",
    custom: "Need something custom?",
    customLink: "Let's talk.",
    note: "Prices are in South African rand. Your website is yours to keep, with no monthly fee to us unless you choose a care plan. Your domain and hosting are in your name, and you pay those providers directly, usually once a year; we tell you that cost before we start. Care plans are month to month, with no lock-in: cancel with 30 days' notice. The website price isn't refundable once work has started.",
    vatYes: "Prices include VAT.",
    vatNo: "IsangoTech is not yet a registered VAT vendor, so no VAT is charged.",
    ctaHeading: "Ready to get found?",
    ctaText: "Tell us a bit about your business and we'll recommend where to start. No pressure, no jargon.",
  },
  xh: {
    title: "Iinkonzo namaxabiso",
    searchTitle: "Ii-website zamashishini amancinci namaxabiso, eMonti",
    description: "Ii-website zokuqalisa ukusuka ku-R3 500 kanye kuphela, ukuseta i-Google Business Profile nezicwangciso zokhathalelo ezikhethwayo zamashishini amancinci eMonti naseMpuma Koloni. Akukho ntlawulo yenyanga, kwaye i-website yeyakho.",
    lead: "Senza ishishini lakho lifumaneke kwi-intanethi. Amaxabiso acacileyo, abhalwe kwikowuti ngaphambi kokuba kuqalwe umsebenzi, ngoko uyazi iindleko zonke kwangaphambili.",
    chatHeading: "Awuqinisekanga ukuba ufuna ntoni? Qala ngencoko yasimahla.",
    chatText: "Sixelele ngeshishini lakho kwaye siza kucebisa apho ungaqala khona, nokuba impendulo enyanisekileyo ithi \"awukayidingi le nto okwangoku\".",
    chatButton: "Cela incoko yasimahla",
    start: "Qalisa",
    addonsHeading: "Iprofayile yakho ye-Google kuphela",
    addonsLead: "Awukakulungeli ukuba ne-website? Qala nge-Google Business Profile yakho.",
    careHeading: "Ukhathalelo emva kokuqalisa",
    careLead: "Kukhethwa. Thatha isicwangciso sokhathalelo ukuba ukhetha ukuba sizikhathalele endaweni yakho.",
    fixes: "Iintsuku ezingama-30 zokulungisa simahla",
    fixesText: "Emva kokunikezela ngomsebenzi, silungisa nantoni na engasebenziyo njengoko kuvunyelwene, ngaphandle kwentlawulo.",
    help: "Uncedo xa ulufuna: R400 ngeyure",
    helpText: "Akunayo isicwangciso sokhathalelo? Cela uncedo nanini na. Sikuxelela ixabiso ngaphambi kokuba siqale.",
    custom: "Ufuna into eyenzelwe wena?",
    customLink: "Masithethe.",
    note: "Amaxabiso akwiirandi zaseMzantsi Afrika. I-website yakho yeyakho, akukho ntlawulo yenyanga kuthi ngaphandle kokuba ukhetha isicwangciso sokhathalelo. I-domain ne-hosting zisegameni lakho, kwaye uhlawula abo baboneleli ngqo, ngokuqhelekileyo kanye ngonyaka; sikuxelela elo xabiso ngaphambi kokuba siqale. Izicwangciso zokhathalelo zingenyanga nenyanga, akukho sivumelwano sikubophelelayo: rhoxisa ngesaziso seentsuku ezingama-30. Ixabiso le-website alibuyiswa xa umsebenzi sele uqalile.",
    vatYes: "Amaxabiso aquka i-VAT.",
    vatNo: "I-IsangoTech ayikabhaliswa njengomthengisi we-VAT, ngoko akuhlawuliswa VAT.",
    ctaHeading: "Ukulungele ukufumaneka?",
    ctaText: "Sixelele kancinci ngeshishini lakho kwaye siza kucebisa apho ungaqala khona. Akukho xinzelelo, akukho magama anzima.",
  },
});

const website = packages.filter((p) => p.group === "website");
const addons = packages.filter((p) => p.group === "addon");
const care = packages.filter((p) => p.group === "care");
---

<Base title={w.title} searchTitle={w.searchTitle} description={w.description}>
  <section class="container intro">
    <h1>{w.title}</h1>
    <p>{w.lead}</p>
    <div class="free-chat">
      <div>
        <h2>{w.chatHeading}</h2>
        <p>{w.chatText}</p>
      </div>
      <a class="button" href={L("/get-started")}>{w.chatButton} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <FoundingOffer />

  <section class="container">
    {
      website.map((p) => (
        <div class="package main">
          <div>
            <p class="stage">{p.label}</p>
            <h2>{p.name}</h2>
            <p class="price">{formatPrice(p, lang)}</p>
            {p.priceDetail && <p class="price-detail">{p.priceDetail}</p>}
            <p>{p.summary}</p>
          </div>
          <div>
            <ul>
              {p.includes.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
            <a class="button" href={L("/get-started")}>
              {w.start} <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ))
    }
  </section>

  <section class="container group" aria-labelledby="addons-heading">
    <h2 id="addons-heading">{w.addonsHeading}</h2>
    <p class="group-lead">{w.addonsLead}</p>
    <ul class="group-list">
      {
        addons.map((p) => (
          <li class="package">
            <p class="stage">{p.label}</p>
            <h3>{p.name}</h3>
            <p class="price">{formatPrice(p, lang)}</p>
            {p.priceDetail && <p class="price-detail">{p.priceDetail}</p>}
            <p>{p.summary}</p>
            <ul>
              {p.includes.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container group" aria-labelledby="care-heading">
    <h2 id="care-heading">{w.careHeading}</h2>
    <p class="group-lead">{w.careLead}</p>
    <ul class="group-list">
      {
        care.map((p) => (
          <li class="package care">
            <p class="stage">{p.label}</p>
            <h3>{p.name}</h3>
            <p class="price">{formatPrice(p, lang)}</p>
            {p.priceDetail && <p class="price-detail">{p.priceDetail}</p>}
            <p>{p.summary}</p>
            <ul>
              {p.includes.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
    <ul class="promises">
      <li>
        <strong>{w.fixes}</strong>
        <span>{w.fixesText}</span>
      </li>
      <li>
        <strong>{w.help}</strong>
        <span>{w.helpText}</span>
      </li>
    </ul>
    <p class="note">
      {w.note}
      {site.vatRegistered ? w.vatYes : w.vatNo}
    </p>
    <p class="custom">{w.custom} <a href={L("/get-started")}>{w.customLink}</a></p>
  </section>

  <CallToAction heading={w.ctaHeading} text={w.ctaText} />
</Base>

<style>
  .intro {
    padding-block: 3rem 1.5rem;
  }
  .intro > * {
    max-width: 48rem;
  }
  .free-chat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    max-width: none;
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    background: var(--white);
    border-left: 6px solid var(--turquoise);
  }
  .free-chat > div {
    max-width: 40rem;
  }
  .free-chat h2 {
    font-size: 1.3rem;
    margin-bottom: 0.25rem;
  }
  .free-chat p {
    margin: 0;
  }
  .package {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: var(--white);
    border-radius: var(--radius);
  }
  .package h2 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }
  .package ul {
    padding-left: 1.2rem;
    margin-bottom: 1.25rem;
  }
  /* The button follows the last point; the "Next step" note sits at the
     bottom of the card, so the dividers line up across a row. */
  .package .button {
    align-self: flex-start;
  }
  .stage {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  .price-detail {
    margin: -0.5rem 0 0.75rem;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .price {
    margin: 0 0 0.75rem;
    font: 600 1.15rem/1.3 var(--font-heading);
    color: var(--turquoise-text);
  }
  .package .button {
    margin-bottom: 1.25rem;
  }
  .promises {
    grid-column: 1 / -1;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
  .promises li {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    background: rgb(43 168 160 / 0.1);
    border-left: 4px solid var(--turquoise);
  }
  .promises strong {
    font: 600 1.1rem/1.3 var(--font-heading);
    color: var(--indigo);
  }
  .care {
    border-left: 6px solid var(--ochre);
  }
  .care ul {
    flex: none;
  }
  .note {
    font-size: 0.9rem;
    opacity: 0.85;
  }
  /* The website is the main offer: one wide card, words beside the list. */
  .main {
    display: grid;
    gap: 0 2.5rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-top: 6px solid var(--turquoise);
  }
  @media (min-width: 52rem) {
    .main {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .main h2 {
    font-size: clamp(1.75rem, 4vw, 2.3rem);
  }
  .group {
    padding-top: 2.5rem;
  }
  .group-lead {
    margin-top: 0;
    max-width: 40rem;
  }
  .group-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .package h3 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }
  .group-list .package ul {
    margin-bottom: 0;
  }
  .promises {
    margin-top: 1.5rem;
  }
  .custom {
    margin: 1.5rem 0 0;
    font-size: 0.95rem;
  }
</style>
