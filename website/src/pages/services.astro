---
import Base from "../layouts/Base.astro";
import CallToAction from "../components/CallToAction.astro";
import FoundingOffer from "../components/FoundingOffer.astro";
import { formatPrice, packagesFor } from "../data/packages";
import { stageByNumber } from "../data/stages";
import { site } from "../site";
import { langOf, localize, pick } from "../i18n";

const lang = langOf(Astro.url);
const L = (path: string) => localize(path, lang);
const packages = packagesFor(lang);
const w = pick(lang, {
  en: {
    title: "Services and pricing",
    searchTitle: "Packages and prices for websites and automation",
    description: "Clear packages and starting prices for websites, booking systems, staff portals and AI automation for small businesses in East London and South Africa.",
    lead: "Our packages follow the growth path. Find the stage your business is at, start there, and see what comes next. Prices are fixed in a written quote before any work starts, so you know the full cost upfront.",
    chatHeading: "Not sure where you fit? Start with a free chat.",
    chatText: "Tell us about your business and we'll recommend where to start, even if the honest answer is \"you don't need this yet\".",
    chatButton: "Book a free chat",
    packagesLabel: "Packages by growth stage",
    stage: "Stage",
    start: "Get started",
    next: "Next step:",
    extrasLabel: "Custom work and care",
    fixes: "30 days of free fixes",
    fixesText: "After every handover, we fix anything that doesn't work as agreed, at no cost.",
    help: "Help when you need it: R400 an hour",
    helpText: "No care plan? Ask for help any time. We tell you the cost before we start.",
    note: "Prices are in South African rand. Websites and custom software are yours to keep, with no monthly fee unless you choose the care plan. The WhatsApp assistant and portal run on our platform, so their monthly fee covers hosting, AI usage (up to a fair limit, set out in your agreement), updates and support. Replying to customers who message you on WhatsApp is free; WhatsApp's own charge for messages you send first, such as reminders, is billed to your business by Meta, usually a few cents each.",
    vatYes: "Prices include VAT.",
    vatNo: "IsangoTech is not yet a registered VAT vendor, so no VAT is charged.",
    ctaHeading: "Not sure which one fits?",
    ctaText: "Tell us a bit about your business and we'll recommend where to start. No pressure, no jargon.",
  },
  xh: {
    title: "Iinkonzo namaxabiso",
    searchTitle: "Iiphakheji namaxabiso ee-website ne-automation",
    description: "Iiphakheji ezicacileyo namaxabiso okuqala ee-website, ii-booking, ii-portal zabasebenzi ne-AI automation zamashishini amancinci eMonti naseMzantsi Afrika.",
    lead: "Iiphakheji zethu zilandela indlela yokukhula. Fumana inqanaba elikulo ishishini lakho, uqale apho, ubone okulandelayo. Amaxabiso amiselwa kwikowuti ebhaliweyo ngaphambi kokuba kuqalwe umsebenzi, ngoko uyazi iindleko zonke kwangaphambili.",
    chatHeading: "Awuqinisekanga ukuba ukweliphi inqanaba? Qala ngencoko yasimahla.",
    chatText: "Sixelele ngeshishini lakho kwaye siza kucebisa apho ungaqala khona, nokuba impendulo enyanisekileyo ithi \"awukayidingi le nto okwangoku\".",
    chatButton: "Cela incoko yasimahla",
    packagesLabel: "Iiphakheji ngokwenqanaba lokukhula",
    stage: "Inqanaba",
    start: "Qalisa",
    next: "Inyathelo elilandelayo:",
    extrasLabel: "Umsebenzi owenzelwe wena nokhathalelo",
    fixes: "Iintsuku ezingama-30 zokulungisa simahla",
    fixesText: "Emva kokunikezela ngomsebenzi, silungisa nantoni na engasebenziyo njengoko kuvunyelwene, ngaphandle kwentlawulo.",
    help: "Uncedo xa ulufuna: R400 ngeyure",
    helpText: "Akunayo i-care plan? Cela uncedo nanini na. Sikuxelela ixabiso ngaphambi kokuba siqale.",
    note: "Amaxabiso akwiirandi zaseMzantsi Afrika. Ii-website ne-software eyenzelwe wena zezakho, akukho ntlawulo yenyanga ngaphandle kokuba ukhetha i-care plan. I-WhatsApp assistant ne-portal zisebenza kwiqonga lethu, ngoko intlawulo yazo yenyanga ihlawulela i-hosting, ukusetyenziswa kwe-AI (ukuya kumda ofanelekileyo, obhalwe kwisivumelwano sakho), uhlaziyo nenkxaso. Ukuphendula abathengi abakuthumelela umyalezo kwi-WhatsApp simahla; imali ye-WhatsApp yemiyalezo oyithumela kuqala, njengezikhumbuzo, ihlawuliswa ishishini lakho yiMeta, ngokuqhelekileyo ziisenti ezimbalwa umyalezo ngamnye.",
    vatYes: "Amaxabiso aquka i-VAT.",
    vatNo: "I-IsangoTech ayikabhaliswa njengomthengisi we-VAT, ngoko akuhlawuliswa VAT.",
    ctaHeading: "Awuqinisekanga ukuba yeyiphi ekulungeleyo?",
    ctaText: "Sixelele kancinci ngeshishini lakho kwaye siza kucebisa apho ungaqala khona. Akukho xinzelelo, akukho magama anzima.",
  },
});

const staged = packages.filter((p) => p.stage !== null);
const everyStage = packages.filter((p) => p.stage === null);
---

<Base title={w.title} searchTitle={w.searchTitle} description={w.description}>
  <section class="container intro">
    <h1>{w.title}</h1>
    <p>{w.lead}</p>
    <div class="free-chat">
      <div>
        <h2>{w.chatHeading}</h2>
        <p>{w.chatText}</p>
      </div>
      <a class="button" href={L("/get-started")}>{w.chatButton} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <FoundingOffer />

  <section class="container" aria-label={w.packagesLabel}>
    <ol class="packages">
      {
        staged.map((p) => {
          const stage = stageByNumber(p.stage!, lang);
          return (
            <li class="package">
              <p class="stage">
                {w.stage} {p.stage} · {stage?.name}
              </p>
              <h2>{p.name}</h2>
              <p class="price">{formatPrice(p, lang)}</p>
              {p.priceDetail && <p class="price-detail">{p.priceDetail}</p>}
              <p>{p.summary}</p>
              <ul>
                {p.includes.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
              <a class="button" href={`${L("/get-started")}?stage=${p.stage}`}>
                {w.start} <span class="arrow" aria-hidden="true">→</span>
              </a>
              {p.nextStep && (
                <p class="next">
                  <strong>{w.next}</strong> {p.nextStep}
                </p>
              )}
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="container extras" aria-label={w.extrasLabel}>
    {
      everyStage.map((p) => (
        <div class="package care">
          <p class="stage">{p.label}</p>
          <h2>{p.name}</h2>
          <p class="price">{formatPrice(p, lang)}</p>
          {p.priceDetail && <p class="price-detail">{p.priceDetail}</p>}
          <p>{p.summary}</p>
          <ul>
            {p.includes.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </div>
      ))
    }
    <ul class="promises">
      <li>
        <strong>{w.fixes}</strong>
        <span>{w.fixesText}</span>
      </li>
      <li>
        <strong>{w.help}</strong>
        <span>{w.helpText}</span>
      </li>
    </ul>
    <p class="note">
      {w.note}
      {site.vatRegistered ? w.vatYes : w.vatNo}
    </p>
  </section>

  <CallToAction heading={w.ctaHeading} text={w.ctaText} />
</Base>

<style>
  .intro {
    padding-block: 3rem 1.5rem;
  }
  .intro > * {
    max-width: 48rem;
  }
  .free-chat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    max-width: none;
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    background: var(--white);
    border-left: 6px solid var(--turquoise);
  }
  .free-chat > div {
    max-width: 40rem;
  }
  .free-chat h2 {
    font-size: 1.3rem;
    margin-bottom: 0.25rem;
  }
  .free-chat p {
    margin: 0;
  }
  .packages {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .package {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: var(--white);
    border-radius: var(--radius);
  }
  .package h2 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }
  .package ul {
    padding-left: 1.2rem;
    margin-bottom: 1.25rem;
  }
  /* The button follows the last point; the "Next step" note sits at the
     bottom of the card, so the dividers line up across a row. */
  .package .button {
    align-self: flex-start;
  }
  .stage {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  .price-detail {
    margin: -0.5rem 0 0.75rem;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .price {
    margin: 0 0 0.75rem;
    font: 600 1.15rem/1.3 var(--font-heading);
    color: var(--turquoise-text);
  }
  .package .button {
    margin-bottom: 1.25rem;
  }
  .next {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgb(27 42 74 / 0.1);
    font-size: 0.95rem;
  }
  .extras {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }
  @media (min-width: 52rem) {
    .extras {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .extras .note {
    grid-column: 1 / -1;
  }
  .promises {
    grid-column: 1 / -1;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
  .promises li {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    background: rgb(43 168 160 / 0.1);
    border-left: 4px solid var(--turquoise);
  }
  .promises strong {
    font: 600 1.1rem/1.3 var(--font-heading);
    color: var(--indigo);
  }
  .care {
    border-left: 6px solid var(--ochre);
  }
  .care ul {
    flex: none;
  }
  .note {
    font-size: 0.9rem;
    opacity: 0.85;
  }
</style>
