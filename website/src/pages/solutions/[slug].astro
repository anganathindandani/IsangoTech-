---
import Base from "../../layouts/Base.astro";
import CallToAction from "../../components/CallToAction.astro";
import { allSolutions, industryFor, type Industry } from "../../data/industries";
import { formatPrice, packagesFor } from "../../data/packages";
import { langOf, localize, pick } from "../../i18n";

export function getStaticPaths() {
  return allSolutions.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }));
}

interface Props {
  industry: Industry;
}

const lang = langOf(Astro.url);
const L = (path: string) => localize(path, lang);
const industry = industryFor(Astro.props.industry, lang);
const starter = packagesFor(lang).find((p) => p.group === "website")!;

// What people type into Google, with the place.
const searchTitles: Record<string, string> = pick(lang, {
  en: {
    salons: "Salon websites in East London",
    restaurants: "Restaurant websites in East London",
    caterers: "Websites for caterers and event companies, East London",
    guesthouses: "Guesthouse websites for direct bookings, East London",
    "auto-repair": "Websites for auto repair shops, East London",
    "cleaning-security": "Websites for cleaning and security firms, East London",
    tutoring: "Websites for tutoring centres, East London",
    gyms: "Gym and fitness studio websites, East London",
    "other-small-businesses": "Small business websites in East London",
  },
  xh: {
    salons: "Ii-website zeesalon eMonti",
    restaurants: "Ii-website zeerestyu eMonti",
    caterers: "Ii-website zabapheki namashishini eminyhadala, eMonti",
    guesthouses: "Ii-website zeendlu zeendwendwe zee-booking ezithe ngqo, eMonti",
    "auto-repair": "Ii-website zeegaraji zokulungisa iimoto, eMonti",
    "cleaning-security": "Ii-website zeenkampani zococeko nezokhuseleko, eMonti",
    tutoring: "Ii-website zamaziko okufundisa, eMonti",
    gyms: "Ii-website zeejim nezitudiyo zokuzilolonga, eMonti",
    "other-small-businesses": "Ii-website zamashishini amancinci eMonti",
  },
});
const w = pick(lang, {
  en: {
    description: `${industry.tagline} Websites and Google Business Profiles for ${industry.name.charAt(0).toLowerCase() + industry.name.slice(1)} in East London and the Eastern Cape, from R3 500 once-off.`,
    crumb: "Solutions",
    familiar: "Sound familiar?",
    does: "What your website does for you",
    price: "Starter website",
    priceDetail: "Once-off. No monthly fee, and the website is yours.",
    seeAll: "See what's included",
    talk: `Let's talk about your ${industry.noun}`,
  },
  xh: {
    description: `${industry.tagline} Ii-website nee-Google Business Profile zamashishini anje eMonti naseMpuma Koloni, ukusuka ku-R3 500 kanye kuphela.`,
    crumb: "Izisombululo",
    familiar: "Ingaba oku kuyaqhelekile kuwe?",
    does: "Oko i-website yakho ikwenzela kona",
    price: "I-website yokuqalisa",
    priceDetail: "Kanye kuphela. Akukho ntlawulo yenyanga, kwaye i-website yeyakho.",
    seeAll: "Bona okubandakanyiweyo",
    talk: industry.talkAbout ?? "Masithethe ngeshishini lakho",
  },
});
---

<Base
  title={industry.name}
  searchTitle={searchTitles[industry.slug]}
  description={w.description}
>
  <section class="hero">
    <div class="container">
      <p class="crumb"><a href={L("/solutions")}>{w.crumb}</a></p>
      <h1>{industry.name}</h1>
      <p class="tagline">{industry.tagline}</p>
    </div>
  </section>

  <section class="container pains" aria-labelledby="pains-heading">
    <h2 id="pains-heading">{w.familiar}</h2>
    <ul>{industry.pains.map((p) => <li>{p}</li>)}</ul>
  </section>

  <section class="container" aria-labelledby="does-heading">
    <h2 id="does-heading">{w.does}</h2>
    <ul class="does">
      {industry.website.map((item) => <li>{item}</li>)}
    </ul>
    <div class="price-card">
      <p class="price-name">{w.price}</p>
      <p class="price">{formatPrice(starter, lang)}</p>
      <p class="price-detail">{w.priceDetail}</p>
      <a href={L("/services")}>{w.seeAll} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <CallToAction heading={w.talk} />
</Base>

<style>
  .hero {
    background: var(--white);
    padding-block: 2.5rem;
  }
  .crumb {
    margin: 0 0 0.5rem;
  }
  .tagline {
    font-size: 1.2rem;
    margin: 0;
  }
  .pains {
    padding-block: 2.5rem 1rem;
  }
  .pains ul {
    padding-left: 1.2rem;
  }
  .pains li {
    margin-bottom: 0.5rem;
  }
  .does {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .does li {
    padding: 1.25rem;
    background: var(--white);
    border-radius: var(--radius);
    border-top: 5px solid var(--turquoise);
  }
  .does li:nth-child(even) {
    border-top-color: var(--ochre);
  }
  .price-card {
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--white);
    border-radius: var(--radius);
    border-left: 6px solid var(--turquoise);
  }
  .price-card p {
    margin: 0;
  }
  .price-name {
    font: 700 1.05rem/1.2 var(--font-heading);
  }
  .price {
    margin-top: 0.25rem !important;
    font: 600 1.2rem/1.3 var(--font-heading);
    color: var(--turquoise-text);
  }
  .price-detail {
    margin: 0.25rem 0 0.75rem !important;
    font-size: 0.95rem;
  }
</style>
