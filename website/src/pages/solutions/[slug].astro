---
import Base from "../../layouts/Base.astro";
import CallToAction from "../../components/CallToAction.astro";
import { allSolutions, industryFor, type Industry } from "../../data/industries";
import { stagesFor } from "../../data/stages";
import { langOf, localize, pick } from "../../i18n";

export function getStaticPaths() {
  return allSolutions.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }));
}

interface Props {
  industry: Industry;
}

const lang = langOf(Astro.url);
const L = (path: string) => localize(path, lang);
const industry = industryFor(Astro.props.industry, lang);
const stages = stagesFor(lang);

// What people type into Google, with the place.
const searchTitles: Record<string, string> = pick(lang, {
  en: {
    salons: "Salon websites and bookings in East London",
    restaurants: "Restaurant websites and bookings, East London",
    caterers: "Websites and quoting for caterers, East London",
    guesthouses: "Guesthouse bookings on WhatsApp, East London",
    "other-small-businesses": "Small business automation in East London",
  },
  xh: {
    salons: "Ii-website nee-booking zeesalon eMonti",
    restaurants: "Ii-website nee-booking zeerestyu, eMonti",
    caterers: "Ii-website neekowuti zabapheki beminyhadala, eMonti",
    guesthouses: "Ii-booking ze-WhatsApp zeendlu zeendwendwe, eMonti",
    "other-small-businesses": "I-automation yamashishini amancinci eMonti",
  },
});
const w = pick(lang, {
  en: {
    description: `${industry.tagline} How IsangoTech helps ${industry.name.toLowerCase()} in East London and the Eastern Cape, from a website to booking systems and AI automation.`,
    crumb: "Solutions",
    familiar: "Sound familiar?",
    path: "What we do at each stage",
    pathLead: "Start where you are. Each step builds on the last, so nothing you pay for gets thrown away.",
    stage: "Stage",
    startAt: (n: number) => `Start at stage ${n} →`,
    demo: "See it working",
    watch: "Watch the demo",
    talk: `Let's talk about your ${industry.noun}`,
  },
  xh: {
    description: `${industry.tagline} I-IsangoTech incedisa amashishini anje eMonti naseMpuma Koloni, ukusuka kwi-website ukuya kwii-booking nakwi-AI automation.`,
    crumb: "Izisombululo",
    familiar: "Ingaba oku kuyaqhelekile kuwe?",
    path: "Esikwenzayo kwinqanaba ngalinye",
    pathLead: "Qala apho ukhoyo. Inyathelo ngalinye lakhela kwelingaphambili, ngoko akukho nto oyihlawulelayo elahlwayo.",
    stage: "Inqanaba",
    startAt: (n: number) => `Qala kwinqanaba ${n} →`,
    demo: "Yibone isebenza",
    watch: "Bukela umboniso",
    talk: industry.talkAbout ?? "Masithethe ngeshishini lakho",
  },
});
---

<Base
  title={industry.name}
  searchTitle={searchTitles[industry.slug]}
  description={w.description}
>
  <section class="hero">
    <div class="container">
      <p class="crumb"><a href={L("/solutions")}>{w.crumb}</a></p>
      <h1>{industry.name}</h1>
      <p class="tagline">{industry.tagline}</p>
    </div>
  </section>

  <section class="container pains" aria-labelledby="pains-heading">
    <h2 id="pains-heading">{w.familiar}</h2>
    <ul>{industry.pains.map((p) => <li>{p}</li>)}</ul>
  </section>

  <section class="container" aria-labelledby="path-heading">
    <h2 id="path-heading">{w.path}</h2>
    <p>{w.pathLead}</p>
    <ol class="path">
      {
        stages.map((s) => (
          <li>
            <span class="num">{w.stage} {s.number} · {s.name}</span>
            <p>{industry.byStage[s.number]}</p>
            <a href={`${L("/get-started")}?stage=${s.number}`}>{w.startAt(s.number)}</a>
          </li>
        ))
      }
    </ol>
  </section>

  {
    industry.demoVideo && (
      <section class="container demo" aria-labelledby="demo-heading">
        <h2 id="demo-heading">{w.demo}</h2>
        <a class="button" href={industry.demoVideo}>
          {w.watch}
        </a>
      </section>
    )
  }

  <CallToAction heading={w.talk} />
</Base>

<style>
  .hero {
    background: var(--white);
    padding-block: 2.5rem;
  }
  .crumb {
    margin: 0 0 0.5rem;
  }
  .tagline {
    font-size: 1.2rem;
    margin: 0;
  }
  .pains {
    padding-block: 2.5rem 1rem;
  }
  .pains ul {
    padding-left: 1.2rem;
  }
  .pains li {
    margin-bottom: 0.5rem;
  }
  .path {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .path li {
    padding: 1.25rem;
    background: var(--white);
    border-radius: var(--radius);
    border-top: 5px solid var(--turquoise);
  }
  .path li:nth-child(even) {
    border-top-color: var(--ochre);
  }
  .num {
    font: 700 1.05rem/1.2 var(--font-heading);
  }
  .demo {
    padding-top: 1.5rem;
  }
</style>
