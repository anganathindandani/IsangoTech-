---
import Base from "../../layouts/Base.astro";
import CallToAction from "../../components/CallToAction.astro";
import IndustryTiles from "../../components/IndustryTiles.astro";
---

<Base title="Solutions" description="Websites, booking tools, portals and automation for salons, restaurants, caterers and other small businesses.">
  <section class="container intro">
    <h1>Solutions for your kind of business</h1>
    <p>
      Salons, restaurants and caterers are our focus industries: we've built templates and workflows that fit them
      closely. Every other small business gets the same growth path, built from the same tested parts.
    </p>
  </section>
  <section class="container">
    <IndustryTiles />
  </section>
  <CallToAction />
</Base>

<style>
  .intro {
    padding-block: 3rem 1.5rem;
  }
  .intro > * {
    max-width: 48rem;
  }
</style>
