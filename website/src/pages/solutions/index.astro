---
import Base from "../../layouts/Base.astro";
import CallToAction from "../../components/CallToAction.astro";
import IndustryTiles from "../../components/IndustryTiles.astro";
---

<Base title="Solutions" searchTitle="WhatsApp assistants and bookings for small businesses"
  description="WhatsApp AI assistants, bookings, reminders and websites for salons, guesthouses, restaurants, caterers and other small businesses in East London and the Eastern Cape.">
  <section class="container intro">
    <h1>Solutions for your kind of business</h1>
    <p>
      Salons, guesthouses, restaurants and caterers are our focus industries: we set up our platform for how each of
      them works. Every other small business gets the same growth path, built from the same parts.
    </p>
  </section>
  <section class="container">
    <IndustryTiles />
  </section>
  <CallToAction />
</Base>

<style>
  .intro {
    padding-block: 3rem 1.5rem;
  }
  .intro > * {
    max-width: 48rem;
  }
</style>
