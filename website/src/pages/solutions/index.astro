---
import Base from "../../layouts/Base.astro";
import CallToAction from "../../components/CallToAction.astro";
import IndustryTiles from "../../components/IndustryTiles.astro";
import { langOf, pick } from "../../i18n";
const w = pick(langOf(Astro.url), {
  en: {
    title: "Solutions",
    searchTitle: "Websites for small businesses in East London",
    description: "Websites and Google Business Profiles for salons, guesthouses, restaurants, caterers, auto repair shops, cleaning and security firms, tutoring centres, gyms and other small businesses in East London and the Eastern Cape.",
    h1: "Solutions for your kind of business",
    lead: "We know what customers look for in each of these businesses, so your website shows it first. Any other small business gets the same care.",
  },
  xh: {
    title: "Izisombululo",
    searchTitle: "Ii-website zamashishini amancinci eMonti",
    description: "Ii-website nee-Google Business Profile zeesalon, iindlu zeendwendwe, iirestyu, abapheki beminyhadala, iigaraji, iinkampani zococeko nezokhuseleko, amaziko okufundisa, iijim namanye amashishini amancinci eMonti naseMpuma Koloni.",
    h1: "Izisombululo zohlobo lweshishini lakho",
    lead: "Siyazi ukuba abathengi bakhangela ntoni kula mashishini, ngoko i-website yakho iyibonisa kuqala. Lonke elinye ishishini elincinci lifumana ukhathalelo olufanayo.",
  },
});
---

<Base title={w.title} searchTitle={w.searchTitle} description={w.description}>
  <section class="container intro">
    <h1>{w.h1}</h1>
    <p>{w.lead}</p>
  </section>
  <section class="container">
    <IndustryTiles />
  </section>
  <CallToAction />
</Base>

<style>
  .intro {
    padding-block: 3rem 1.5rem;
  }
  .intro > * {
    max-width: 48rem;
  }
</style>
