---
import Base from "../layouts/Base.astro";
import CallToAction from "../components/CallToAction.astro";
import Beadwork from "../components/Beadwork.astro";
import { site } from "../site";

const values = [
  { name: "Results over hype", text: "We measure our work by time saved and customers won, not by buzzwords." },
  { name: "Honesty", text: "If you don't need something yet, we'll tell you. Clear prices, no surprises." },
  { name: "Responsibility", text: "We look after your data and your customers' data as carefully as our own." },
  { name: "Partnership", text: "We grow with you, one stage at a time, and stay around after go-live." },
];
---

<Base title="About" searchTitle="Our story and founder, East London"
  description="IsangoTech is an East London technology business founded by Anganathi Ndandani, helping Eastern Cape small businesses get found, answer every enquiry and automate admin.">
  <section class="hero">
    <div class="container">
      <h1>About IsangoTech</h1>
      <p class="lead">
        <em>Isango</em> means gate. We named the business for what we want to be for small businesses: the way through
        to smarter, simpler ways of working.
      </p>
    </div>
  </section>
  <Beadwork />

  <section class="container story">
    <h2>Why we exist</h2>
    <p>
      Small businesses are the heart of East London and the Eastern Cape, but most software is built for big companies
      with big budgets. Owners end up running their business from WhatsApp threads, notebooks and spreadsheets, and
      losing customers and hours along the way.
    </p>
    <p>
      We build the tools that close that gap: a website that gets you found, simple systems that catch every enquiry,
      a portal that runs your day, and automation that takes the repetitive work off your plate. We start where your
      business is today and grow with you.
    </p>

    <div class="pair">
      <div>
        <h2>Our vision</h2>
        <p>Every small business in South Africa running on tools that work as hard as its owner does.</p>
      </div>
      <div>
        <h2>Our mission</h2>
        <p>
          Help small businesses get found, capture customers, run their operations and automate repetitive work, in
          plain language and at a fair price.
        </p>
      </div>
    </div>
  </section>

  {
    site.founder.name && (
      <section class="container founder" id="founder" aria-labelledby="founder-heading">
        <figure class="photo">
          <img
            src={site.founder.photo}
            srcset={`${site.founder.photoSmall} 480w, ${site.founder.photo} 960w`}
            sizes="(min-width: 52rem) 22rem, 80vw"
            width="960"
            height="960"
            loading="lazy"
            alt={`${site.founder.name}, ${site.founder.role} of IsangoTech`}
          />
        </figure>
        <div class="words">
          <p class="eyebrow">Meet the founder</p>
          <h2 id="founder-heading">{site.founder.name}</h2>
          <p class="role">{site.founder.role}, IsangoTech</p>
          {site.founder.story.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>
    )
  }

  <section class="container values-section" aria-labelledby="values-heading">
    <h2 id="values-heading">What we stand for</h2>
    <ul class="values">
      {
        values.map((v) => (
          <li>
            <h3>{v.name}</h3>
            <p>{v.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container roots">
    <h2>Proudly African, rooted in East London</h2>
    <p>
      We started in East London and we're building for the Eastern Cape and the rest of South Africa. We work in person
      when it helps and online when it's quicker, and we understand the businesses we serve because they're our
      neighbours.
    </p>
  </section>

  <CallToAction />
</Base>

<style>
  .hero {
    background: var(--white);
    padding-block: 3rem 2.5rem;
  }
  .lead {
    max-width: 40rem;
    font-size: 1.2rem;
    margin: 0;
  }
  .story,
  .roots {
    padding-block: 2.5rem 0;
  }
  .founder {
    scroll-margin-top: 5rem;
    display: grid;
    gap: 2rem;
    align-items: center;
    padding-block: 4rem 1.5rem;
  }
  @media (min-width: 52rem) {
    .founder {
      grid-template-columns: 22rem 1fr;
      gap: 3.5rem;
    }
  }
  .photo {
    position: relative;
    margin: 0;
    max-width: 22rem;
    justify-self: center;
  }
  /* An ochre door-frame offset behind the photo, echoing the logo. */
  .photo::before {
    content: "";
    position: absolute;
    inset: 1rem -1rem -1rem 1rem;
    border: 4px solid var(--ochre);
    border-radius: calc(var(--radius) * 2);
  }
  .photo img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) * 2);
    box-shadow: 0 24px 48px -24px rgb(27 42 74 / 0.45);
  }
  .words {
    max-width: 40rem;
  }
  .words h2 {
    margin-bottom: 0.15rem;
  }
  .role {
    margin-top: 0;
    font-weight: 500;
    color: var(--turquoise-text);
  }
  .story > *,
  .roots > * {
    max-width: 48rem;
  }
  .pair {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin-top: 2rem;
  }
  .values-section {
    padding-top: 3rem;
  }
  .values {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .values li {
    padding: 1.25rem;
    background: var(--white);
    border-radius: var(--radius);
  }
  .values h3 {
    font-size: 1.15rem;
    color: var(--turquoise-text);
  }
  .values p {
    margin: 0;
  }
</style>
