---
import Base from "../layouts/Base.astro";
import CallToAction from "../components/CallToAction.astro";
import Beadwork from "../components/Beadwork.astro";
import { site, siteText } from "../site";
import { langOf, pick } from "../i18n";

const lang = langOf(Astro.url);
const t = siteText[lang];
const w = pick(lang, {
  en: {
    title: "About",
    searchTitle: "Our story and founder, East London",
    description: "IsangoTech is an East London technology business founded by Anganathi Ndandani, helping Eastern Cape small businesses get found, answer every enquiry and automate admin.",
    h1: "About IsangoTech",
    lead: "<em>Isango</em> means gate. We named the business for what we want to be for small businesses: the way through to smarter, simpler ways of working.",
    why: "Why we exist",
    why1: "Small businesses are the heart of East London and the Eastern Cape, but most software is built for big companies with big budgets. Owners end up running their business from WhatsApp threads, notebooks and spreadsheets, and losing customers and hours along the way.",
    why2: "We build the tools that close that gap: a website that gets you found, simple systems that catch every enquiry, a portal that runs your day, and automation that takes the repetitive work off your plate. We start where your business is today and grow with you.",
    vision: "Our vision",
    visionText: "Every small business in South Africa running on tools that work as hard as its owner does.",
    mission: "Our mission",
    missionText: "Help small businesses get found, capture customers, run their operations and automate repetitive work, in plain language and at a fair price.",
    meet: "Meet the founder",
    role: `${site.founder.role}, IsangoTech`,
    alt: `${site.founder.name}, ${site.founder.role} of IsangoTech`,
    valuesHeading: "What we stand for",
    values: [
      { name: "Results over hype", text: "We measure our work by time saved and customers won, not by buzzwords." },
      { name: "Honesty", text: "If you don't need something yet, we'll tell you. Clear prices, no surprises." },
      { name: "Responsibility", text: "We look after your data and your customers' data as carefully as our own." },
      { name: "Partnership", text: "We grow with you, one stage at a time, and stay around after go-live." },
    ],
    roots: "Proudly African, rooted in East London",
    rootsText: "We started in East London and we're building for the Eastern Cape and the rest of South Africa. We work in person when it helps and online when it's quicker, and we understand the businesses we serve because they're our neighbours.",
  },
  xh: {
    title: "Ngathi",
    searchTitle: "Ibali lethu nomseki, eMonti",
    description: "I-IsangoTech lishishini lobuchwepheshe laseMonti elasekwa nguAnganathi Ndandani, elincedisa amashishini amancinci aseMpuma Koloni ukuba afumaneke, aphendule wonke umbuzo, kwaye i-admin yenzeke ngokuzenzekelayo.",
    h1: "Malunga ne-IsangoTech",
    lead: "Ishishini salinika igama elithi <em>isango</em> ngenxa yento esifuna ukuba yiyo kumashishini amancinci: indlela yokungena kwiindlela zokusebenza ezikrelekrele nezilula.",
    why: "Kutheni sikhona",
    why1: "Amashishini amancinci yintliziyo yaseMonti naseMpuma Koloni, kodwa uninzi lwe-software lwenzelwe iinkampani ezinkulu ezinemali eninzi. Abanini bagqibela beqhuba amashishini abo ngemicu ye-WhatsApp, iincwadana nee-spreadsheet, bephulukana nabathengi neeyure endleleni.",
    why2: "Sakha izixhobo ezivala eso sithuba: i-website ekwenza ufumaneke, iinkqubo ezilula ezibamba wonke umbuzo, i-portal eqhuba usuku lwakho, ne-automation ekususela imisebenzi ephindaphindwayo. Siqala apho ishishini lakho likhoyo namhlanje, size sikhule nawe.",
    vision: "Umbono wethu",
    visionText: "Lonke ishishini elincinci eMzantsi Afrika lisebenzisa izixhobo ezisebenza nzima njengomnini walo.",
    mission: "Injongo yethu",
    missionText: "Ukunceda amashishini amancinci afumaneke, afumane abathengi, aqhube imisebenzi yawo, kwaye imisebenzi ephindaphindwayo yenzeke ngokuzenzekelayo, ngolwimi olucacileyo nangexabiso elifanelekileyo.",
    meet: "Dibana nomseki",
    role: "Umseki we-IsangoTech",
    alt: `${site.founder.name}, umseki we-IsangoTech`,
    valuesHeading: "Esimela kuko",
    values: [
      { name: "Iziphumo ngaphezu kwengxolo", text: "Silinganisa umsebenzi wethu ngexesha elongiweyo nabathengi abafunyenweyo, hayi ngamagama amnandi." },
      { name: "Ukunyaniseka", text: "Ukuba awukayidingi into, siza kukuxelela. Amaxabiso acacileyo, akukho zimanga." },
      { name: "Uxanduva", text: "Sikhathalela idatha yakho nedatha yabathengi bakho ngononophelo njengeyethu." },
      { name: "Intsebenziswano", text: "Sikhula nawe, inqanaba ngenqanaba, kwaye sihlala nawe emva kokuba inkqubo iqalile ukusebenza." },
    ],
    roots: "Simi ngobu-Afrika, sineengcambu eMonti",
    rootsText: "Saqala eMonti kwaye sakhela iMpuma Koloni nawo wonke uMzantsi Afrika. Sidibana ebusweni xa kunceda nakwi-intanethi xa kukhawuleza ngakumbi, kwaye siyawaqonda amashishini esiwakhonzayo kuba ngabamelwane bethu.",
  },
});
const values = w.values;
---

<Base title={w.title} searchTitle={w.searchTitle} description={w.description}>
  <section class="hero">
    <div class="container">
      <h1>{w.h1}</h1>
      <p class="lead" set:html={w.lead} />
    </div>
  </section>
  <Beadwork />

  <section class="container story">
    <h2>{w.why}</h2>
    <p>{w.why1}</p>
    <p>{w.why2}</p>

    <div class="pair">
      <div>
        <h2>{w.vision}</h2>
        <p>{w.visionText}</p>
      </div>
      <div>
        <h2>{w.mission}</h2>
        <p>{w.missionText}</p>
      </div>
    </div>
  </section>

  {
    site.founder.name && (
      <section class="container founder" id="founder" aria-labelledby="founder-heading">
        <figure class="photo">
          <img
            src={site.founder.photo}
            srcset={`${site.founder.photoSmall} 480w, ${site.founder.photo} 960w`}
            sizes="(min-width: 52rem) 22rem, 80vw"
            width="960"
            height="960"
            loading="lazy"
            alt={w.alt}
          />
        </figure>
        <div class="words">
          <p class="eyebrow">{w.meet}</p>
          <h2 id="founder-heading">{site.founder.name}</h2>
          <p class="role">{w.role}</p>
          {t.founderStory.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>
    )
  }

  <section class="container values-section" aria-labelledby="values-heading">
    <h2 id="values-heading">{w.valuesHeading}</h2>
    <ul class="values">
      {
        values.map((v) => (
          <li>
            <h3>{v.name}</h3>
            <p>{v.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container roots">
    <h2>{w.roots}</h2>
    <p>{w.rootsText}</p>
  </section>

  <CallToAction />
</Base>

<style>
  .hero {
    background: var(--white);
    padding-block: 3rem 2.5rem;
  }
  .lead {
    max-width: 40rem;
    font-size: 1.2rem;
    margin: 0;
  }
  .story,
  .roots {
    padding-block: 2.5rem 0;
  }
  .founder {
    scroll-margin-top: 5rem;
    display: grid;
    gap: 2rem;
    align-items: center;
    padding-block: 4rem 1.5rem;
  }
  @media (min-width: 52rem) {
    .founder {
      grid-template-columns: 22rem 1fr;
      gap: 3.5rem;
    }
  }
  .photo {
    position: relative;
    margin: 0;
    max-width: 22rem;
    justify-self: center;
  }
  /* An ochre door-frame offset behind the photo, echoing the logo. */
  .photo::before {
    content: "";
    position: absolute;
    inset: 1rem -1rem -1rem 1rem;
    border: 4px solid var(--ochre);
    border-radius: calc(var(--radius) * 2);
  }
  .photo img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) * 2);
    box-shadow: 0 24px 48px -24px rgb(27 42 74 / 0.45);
  }
  .words {
    max-width: 40rem;
  }
  .words h2 {
    margin-bottom: 0.15rem;
  }
  .role {
    margin-top: 0;
    font-weight: 500;
    color: var(--turquoise-text);
  }
  .story > *,
  .roots > * {
    max-width: 48rem;
  }
  .pair {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin-top: 2rem;
  }
  .values-section {
    padding-top: 3rem;
  }
  .values {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .values li {
    padding: 1.25rem;
    background: var(--white);
    border-radius: var(--radius);
  }
  .values h3 {
    font-size: 1.15rem;
    color: var(--turquoise-text);
  }
  .values p {
    margin: 0;
  }
</style>
