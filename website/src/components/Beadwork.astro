---
// Signature beadwork band from the brand board. Decorative only.
interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
---

<div class="beadwork" style={`--bead: ${size}px`} aria-hidden="true"></div>

<style>
  .beadwork {
    height: var(--bead);
    background: url("/brand/beadwork.svg") repeat-x left center / var(--bead) var(--bead);
    animation: drift 40s linear infinite;
  }
  /* Slow drift; one full tile per cycle step keeps the pattern seamless. */
  @keyframes drift {
    to {
      background-position-x: calc(var(--bead) * 20);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .beadwork {
      animation: none;
    }
  }
</style>
