---
import { solutionsFor } from "../data/industries";
import { langOf, localize, pick } from "../i18n";
const lang = langOf(Astro.url);
const allSolutions = solutionsFor(lang);
const more = pick(lang, { en: "See how we help", xh: "Bona indlela esinceda ngayo" });

// Simple geometric icons in the brand colours, one per industry.
const icons: Record<string, string> = {
  // Scissors
  salons:
    '<circle cx="14" cy="34" r="6" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="34" cy="34" r="6" fill="none" stroke="currentColor" stroke-width="3"/><path d="M18 29L36 8M30 29L12 8" stroke="#E07A1F" stroke-width="3" stroke-linecap="round"/>',
  // Plate with knife and fork
  restaurants:
    '<circle cx="24" cy="26" r="11" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="24" cy="26" r="5" fill="#E07A1F"/><path d="M6 8v12M6 20v20M4 8v8a2 2 0 0 0 4 0V8M42 8c-3 2-4 6-4 12h4v20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>',
  // Covered serving dish
  caterers:
    '<path d="M8 32a16 16 0 0 1 32 0z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><circle cx="24" cy="13" r="3" fill="#E07A1F"/><path d="M5 37h38" stroke="#E07A1F" stroke-width="3" stroke-linecap="round"/>',
  // House with a door of light
  guesthouses:
    '<path d="M6 22L24 8l18 14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M11 19v21h26V19" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><rect x="20" y="27" width="8" height="13" fill="#E07A1F"/>',
  // Spanner
  "auto-repair":
    '<path d="M30 8a9 9 0 0 0-8 12L8 34a4 4 0 0 0 6 6l14-14a9 9 0 0 0 12-8l-6 4-5-1-1-5z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><circle cx="11" cy="37" r="2" fill="#E07A1F"/>',
  // Shield with a tick
  "cleaning-security":
    '<path d="M24 6l15 6v10c0 9-6 16-15 20C15 38 9 31 9 22V12z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M17 24l5 5 9-10" fill="none" stroke="#E07A1F" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>',
  // Open book
  tutoring:
    '<path d="M24 13c-5-4-11-4-17-2v25c6-2 12-2 17 2 5-4 11-4 17-2V11c-6-2-12-2-17 2z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M24 13v25" stroke="#E07A1F" stroke-width="3"/>',
  // Dumbbell
  gyms:
    '<path d="M16 24h16" stroke="#E07A1F" stroke-width="4" stroke-linecap="round"/><rect x="9" y="14" width="7" height="20" rx="2" fill="none" stroke="currentColor" stroke-width="3"/><rect x="32" y="14" width="7" height="20" rx="2" fill="none" stroke="currentColor" stroke-width="3"/><path d="M5 20v8M43 20v8" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>',
  // Shopfront
  "other-small-businesses":
    '<path d="M8 20v20h32V20" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M6 20l4-12h28l4 12z" fill="#E07A1F"/><rect x="20" y="28" width="8" height="12" fill="none" stroke="currentColor" stroke-width="3"/>',
};
---

<ul class="tiles">
  {
    allSolutions.map((i) => (
      <li>
        <a href={localize(`/solutions/${i.slug}`, lang)}>
          {icons[i.slug] && <svg viewBox="0 0 48 48" width="44" height="44" aria-hidden="true" set:html={icons[i.slug]} />}
          <span class="name">{i.name}</span>
          <span class="tagline">{i.tagline}</span>
          <span class="more">
            {more} <span class="arrow" aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  /* Wide screens: three across. A last row of two shares the width evenly,
     and a single last tile spans it, so there's never an empty gap. */
  @media (min-width: 46rem) {
    .tiles {
      grid-template-columns: repeat(6, 1fr);
    }
    .tiles li {
      grid-column: span 2;
    }
    .tiles li:nth-child(3n + 1):nth-last-child(2),
    .tiles li:nth-child(3n + 2):last-child {
      grid-column: span 3;
    }
    .tiles li:nth-child(3n + 1):last-child {
      grid-column: span 6;
    }
  }
  a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    box-sizing: border-box;
    padding: 1.4rem;
    border-radius: var(--radius);
    background: var(--indigo);
    color: var(--sand);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }
  /* Ochre edge that grows into a turquoise one on hover. */
  a::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 6px;
    background: var(--ochre);
    transition:
      width 0.3s var(--ease-out),
      background 0.3s var(--ease-out);
  }
  a:hover,
  a:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -14px rgb(27 42 74 / 0.6);
  }
  a:hover::before,
  a:focus-visible::before {
    width: 10px;
    background: var(--turquoise);
  }
  svg {
    color: var(--turquoise);
    margin-bottom: 0.4rem;
    transition: transform 0.4s var(--ease-out);
  }
  a:hover svg,
  a:focus-visible svg {
    transform: rotate(-6deg) scale(1.08);
  }
  .name {
    font: 700 1.25rem/1.2 var(--font-heading);
    color: var(--white);
  }
  .tagline {
    flex: 1;
  }
  .more {
    margin-top: 0.4rem;
    font-weight: 500;
    color: var(--turquoise);
  }
</style>
