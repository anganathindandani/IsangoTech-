---
import { allSolutions } from "../data/industries";

// Simple geometric icons in the brand colours, one per industry.
const icons: Record<string, string> = {
  // Scissors
  salons:
    '<circle cx="14" cy="34" r="6" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="34" cy="34" r="6" fill="none" stroke="currentColor" stroke-width="3"/><path d="M18 29L36 8M30 29L12 8" stroke="#E07A1F" stroke-width="3" stroke-linecap="round"/>',
  // Plate with knife and fork
  restaurants:
    '<circle cx="24" cy="26" r="11" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="24" cy="26" r="5" fill="#E07A1F"/><path d="M6 8v12M6 20v20M4 8v8a2 2 0 0 0 4 0V8M42 8c-3 2-4 6-4 12h4v20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>',
  // Covered serving dish
  caterers:
    '<path d="M8 32a16 16 0 0 1 32 0z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><circle cx="24" cy="13" r="3" fill="#E07A1F"/><path d="M5 37h38" stroke="#E07A1F" stroke-width="3" stroke-linecap="round"/>',
  // Shopfront
  "other-small-businesses":
    '<path d="M8 20v20h32V20" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M6 20l4-12h28l4 12z" fill="#E07A1F"/><rect x="20" y="28" width="8" height="12" fill="none" stroke="currentColor" stroke-width="3"/>',
};
---

<ul class="tiles">
  {
    allSolutions.map((i) => (
      <li>
        <a href={`/solutions/${i.slug}`}>
          {icons[i.slug] && <svg viewBox="0 0 48 48" width="44" height="44" aria-hidden="true" set:html={icons[i.slug]} />}
          <span class="name">{i.name}</span>
          <span class="tagline">{i.tagline}</span>
          <span class="more">
            See how we help <span class="arrow" aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    box-sizing: border-box;
    padding: 1.4rem;
    border-radius: var(--radius);
    background: var(--indigo);
    color: var(--sand);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }
  /* Ochre edge that grows into a turquoise one on hover. */
  a::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 6px;
    background: var(--ochre);
    transition:
      width 0.3s var(--ease-out),
      background 0.3s var(--ease-out);
  }
  a:hover,
  a:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -14px rgb(27 42 74 / 0.6);
  }
  a:hover::before,
  a:focus-visible::before {
    width: 10px;
    background: var(--turquoise);
  }
  svg {
    color: var(--turquoise);
    margin-bottom: 0.4rem;
    transition: transform 0.4s var(--ease-out);
  }
  a:hover svg,
  a:focus-visible svg {
    transform: rotate(-6deg) scale(1.08);
  }
  .name {
    font: 700 1.25rem/1.2 var(--font-heading);
    color: var(--white);
  }
  .tagline {
    flex: 1;
  }
  .more {
    margin-top: 0.4rem;
    font-weight: 500;
    color: var(--turquoise);
  }
</style>
