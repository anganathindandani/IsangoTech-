// Cloudflare Workers settings: serve the built Flutter web app (build/web/).
// Unknown paths fall back to index.html so links like /chats/... work after a refresh.
{
  "name": "isangotech-business-app",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "app.isangotech.co.za", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application"
  }
}
